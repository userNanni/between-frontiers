## Interface scale and sizes of screen.

settings-ui-scale-now = Now { $percent }% · logical screen { $width } × { $height }
settings-ui-scale-auto = Automatic
settings-ui-scale-fixed = Fixed
settings-ui-scale-stream = For a stream
settings-ui-stream-hd = 1280 × 720
settings-ui-stream-phone = 960 × 540 (phone)
settings-ui-stream-hint = The interface takes the size it would have on a screen of that size, so viewers can read it however small they watch. Pairs with the HUD's streaming preset.
settings-ui-scale-keep-ask = Keep this interface size? It goes back in { $seconds } s.
settings-ui-scale-keep = Keep
settings-ui-scale-revert = Go back
cmd-system-ui-scale-up = Larger interface
    .short = Larger UI
cmd-system-ui-scale-down = Smaller interface
    .short = Smaller UI
cmd-system-ui-stream = Interface for a stream
    .short = Stream UI
settings-ui-scale-step-tip = One step smaller or larger. Ctrl + − and Ctrl + = do the same anywhere.
settings-display = Display
settings-display-hint = Window, borderless window or full screen. F11 or Alt+Enter toggle full screen on any screen of the game.
settings-display-windowed = Window
settings-display-borderless = Borderless window
settings-display-fullscreen = Full screen
settings-display-size = Window size
settings-display-monitor-size = Monitor size
settings-display-note = Full screen fills the whole monitor at its resolution; the size chosen is for Window mode. To draw the interface smaller or larger, use the interface scale, just below.
settings-display-wayland = Wayland has no resolution change: full screen is the borderless window the size of the monitor, and the size chosen is for Window mode. To draw the interface smaller or larger, use the interface scale, just below.
settings-display-monitor = This monitor: { $w } × { $h }. To play on another monitor, move the window to it and choose here.
settings-display-keep-ask = Keep this display? It goes back to the previous one in { $seconds } s.
cmd-system-fullscreen = Full screen (on and off)
    .short = Full screen
