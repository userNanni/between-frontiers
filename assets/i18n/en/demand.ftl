# The answer to a demand of independence, in the Agendas.

demand-states = States: { $list }
demand-account = What holding it costs, a year
demand-payers = Who makes us pay it: { $list }
demand-answers = Answers
demand-after = After this answer
demand-confirm = { $answer }: { $unit }?
demand-self-rule-note = The colony stays; the costs stay this year, while the movement fades.
points-reason-demand = Before answering a demand of independence
demand-review = Review the answer
demand-final = The answer goes to the colony and cannot be taken back; a restore point is saved first.
demand-yes = Send the answer
demand-closeness-ready = Ready to revolt: if you refuse, the colony breaks away without an agreement.
demand-closeness-near = Near the revolt: a little more and a refusal makes the colony break away without an agreement.
demand-closeness-far = Far from the revolt: refused today, the colony stays for now.
demand-closeness-number = Mobilization { $mobilized } ‰ of 1000; a refusal turns into a revolt from { $revolt } ‰.
demand-refusal-revolt-now = Refused, the colony breaks away without an agreement: it is already mobilized enough ({ $mobilized } ‰; { $mark } ‰ is enough).
demand-refusal-revolt-later = Refused, the colony stays for now; it breaks away without an agreement if mobilization reaches { $mark } ‰ (now { $mobilized } ‰).
demand-colonial-war = Refused, the revolt becomes a colonial war (a restore point is written before the answer). With the troops you have now you hold { $held }; { $proclaimed } proclaims.
demand-colonial-war-none = Refused, the revolt becomes a colonial war (a restore point is written before the answer). The troops you have now hold no state; { $proclaimed } proclaims.
