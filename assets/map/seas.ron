    straits: [
        (id: 0, key: "gibraltar", name: "Strait of Gibraltar", kind: Strait, a: 35, b: 20, shores: [303, 201, 213], opened: None, regime: Some("No passage treaty in 1925 (the 1904 Entente Cordiale bars fortifying part of the Moroccan coast); transit passage under UNCLOS Part III (signed 1982-12-10, in force 1994-11-16). WP \'Strait of Gibraltar\' (Territorial waters); WP \'Transit passage\'"), holders: [], source: "Natural Earth \'Strait of Gibraltar\'; shores from assets/map/provinces.ron"),
        (id: 1, key: "dover", name: "Strait of Dover", kind: Strait, a: 14, b: 19, shores: [276, 255], opened: None, regime: Some("Transit passage under UNCLOS Part III from 1994. WP \'Transit passage\'"), holders: [], source: "shores from assets/map/provinces.ron"),
        (id: 2, key: "oresund", name: "Øresund", kind: Strait, a: 15, b: 16, shores: [188, 734], opened: None, regime: Some("Copenhagen Convention of 1857 (signed 1857-03-14): Sound Dues abolished, free to all commercial shipping; silent on warships and war; kept by UNCLOS art. 35(c). WP \'Copenhagen Convention of 1857\'; WP \'Transit passage\'"), holders: [], source: "Natural Earth \'Øresund\'; shores from assets/map/provinces.ron"),
        (id: 3, key: "great_belt", name: "Great and Little Belts", kind: Strait, a: 15, b: 16, shores: [188, 187], opened: None, regime: Some("Copenhagen Convention of 1857, as the Øresund; the Belts are Danish territorial waters. WP \'Danish straits\'"), holders: [], source: "shores from assets/map/provinces.ron (the Belts lie between Danish islands)"),
        (id: 4, key: "kiel_canal", name: "Kiel Canal", kind: Canal, a: 14, b: 16, shores: [181], opened: Some("1895-06-20"), regime: Some("Treaty of Versailles arts. 380–386 (in force 1920-01-10): open to ships of all nations at peace with Germany; S.S. Wimbledon (PCIJ, 1923-08-17); repudiated by Germany in 1936. Avalon Project, Versailles Part XII s. VI; WP \'Kiel Canal\'. Opening: WP \'Kiel Canal\' (Construction and expansion)"), holders: [], source: "canal across Schleswig-Holstein; shore from assets/map/provinces.ron"),
        (id: 5, key: "messina", name: "Strait of Messina", kind: Strait, a: 21, b: 25, shores: [411, 401], opened: None, regime: Some("Italian territorial waters; no passage treaty found"), holders: [], source: "shores from assets/map/provinces.ron"),
        (id: 6, key: "otranto", name: "Strait of Otranto", kind: Strait, a: 22, b: 25, shores: [409, 6], opened: None, regime: Some("No passage treaty found; transit passage under UNCLOS Part III from 1994"), holders: [], source: "shores from assets/map/provinces.ron"),
        (id: 7, key: "corinth_canal", name: "Corinth Canal", kind: Canal, a: 25, b: 23, shores: [313, 315], opened: Some("1893-07-25"), regime: Some("Greek national canal, no treaty. Opening: WP \'Corinth Canal\' (formally opened 1893-07-25, calendar not stated; navigation from November 1894)"), holders: [], source: "canal across the isthmus of Corinth; shores from assets/map/provinces.ron"),
        (id: 8, key: "dardanelles", name: "Dardanelles", kind: Strait, a: 23, b: 24, shores: [761], opened: None, regime: Some("Lausanne Straits Convention (signed 1923-07-24, in force with the Treaty of Lausanne 1924-08-06): free passage, Turkey may stop only enemy ships when at war; replaced by the Montreux Convention (signed 1936-07-20, in force 1936-11-09), under which Turkey may close the Straits to warships in war or under threat. Wikisource \'Convention relating to the Straits\'; WP \'Montreux Convention Regarding the Regime of the Straits\'"), holders: [], source: "Natural Earth \'Dardanelles\'; Çanakkale and Gallipoli in TUR-BATI-MARMARA"),
        (id: 9, key: "bosporus", name: "Bosporus", kind: Strait, a: 24, b: 28, shores: [766], opened: None, regime: Some("Lausanne Straits Convention (1923), then the Montreux Convention (1936), as the Dardanelles"), holders: [], source: "Natural Earth \'Bosporus\' (3 pixels: the texture does not join the seas)"),
        (id: 10, key: "kerch", name: "Kerch Strait", kind: Strait, a: 28, b: 27, shores: [661, 662], opened: None, regime: Some("Russia–Ukraine agreement on the Sea of Azov and the Kerch Strait (signed 2003-12-24, in force 2004-04-23; denounced 2023): third-state warships pass only with consent. WP \'Treaty Between the Russian Federation and Ukraine on Cooperation in the Use of the Sea of Azov and the Kerch Strait\'"), holders: [], source: "shores from assets/map/provinces.ron"),
        (id: 11, key: "suez_canal", name: "Suez Canal", kind: Canal, a: 26, b: 39, shores: [196], opened: Some("1869-11-17"), regime: Some("Convention of Constantinople (signed 1888-10-29, in force 1904-04-08): passage in war and peace, art. X lets Egypt act for its defence; British reserved points of 1922-02-28; Anglo-Egyptian Treaty of 1936; nationalised 1956-07-26. WP \'Convention of Constantinople\'; WP \'Unilateral Declaration of Egyptian Independence\'; WP \'Suez Canal\'. Opening: WP \'Suez Canal\' (Inauguration)"), holders: [(tag: "GBR", from: "1922-02-28", until: Some("1956-06"), source: "British troops guard the canal: reserved point (a) of the Unilateral Declaration of Egyptian Independence (1922-02-28), then the Anglo-Egyptian Treaty of 1936; withdrawal completed in June 1956. WP \'Unilateral Declaration of Egyptian Independence\' (Text); WP \'Anglo-Egyptian treaty of 1936\' (Treaty provisions; Aftermath)")], source: "Port Said, Ismailia and Suez are in EGY-EASTERN-DELTA (assets/map/provinces.ron)"),
        (id: 12, key: "bab_el_mandeb", name: "Bab-el-Mandeb", kind: Strait, a: 39, b: 40, shores: [863, 864, 186, 200], opened: None, regime: Some("No passage treaty; transit passage under UNCLOS Part III from 1994. WP \'Bab-el-Mandeb\'"), holders: [], source: "Natural Earth \'Bab el Mandeb\'; shores from assets/map/provinces.ron"),
        (id: 13, key: "hormuz", name: "Strait of Hormuz", kind: Strait, a: 41, b: 42, shores: [391, 570], opened: None, regime: Some("No passage treaty; a 1968 traffic separation scheme with Oman; transit passage under UNCLOS Part III, contested by Iran and Oman. WP \'Strait of Hormuz\' (Navigation)"), holders: [], source: "shores from assets/map/provinces.ron (Bandar Abbas; Musandam)"),
        (id: 14, key: "malacca", name: "Strait of Malacca and Singapore", kind: Strait, a: 43, b: 48, shores: [536, 533, 347, 342], opened: None, regime: Some("No passage treaty found; transit passage under UNCLOS Part III from 1994. WP \'Strait of Malacca\'; WP \'Transit passage\'"), holders: [], source: "Natural Earth \'Strait of Malacca\', \'Strait of Singapore\'; shores from assets/map/provinces.ron"),
        (id: 15, key: "sunda", name: "Sunda Strait", kind: Strait, a: 47, b: 46, shores: [336, 351], opened: None, regime: Some("No passage treaty found"), holders: [], source: "shores from assets/map/provinces.ron (Banten, Lampung)"),
        (id: 16, key: "lombok", name: "Lombok Strait", kind: Strait, a: 47, b: 46, shores: [335], opened: None, regime: Some("No passage treaty found"), holders: [], source: "between Bali and Lombok, both in IDN-BALI-LOMBOK"),
        (id: 17, key: "tsushima", name: "Korea Strait (Tsushima)", kind: Strait, a: 53, b: 55, shores: [454, 427, 431], opened: None, regime: Some("No passage treaty found"), holders: [], source: "Natural Earth \'Korea Strait\'; shores from assets/map/provinces.ron (Pusan; Fukuoka; Nagasaki with Tsushima)"),
        (id: 18, key: "tsugaru", name: "Tsugaru Strait", kind: Strait, a: 55, b: 59, shores: [423, 430], opened: None, regime: Some("No passage treaty found"), holders: [], source: "Natural Earth \'Tsugaru Strait\'; Aomori in JPN-OU"),
        (id: 19, key: "la_perouse", name: "La Pérouse Strait (Sōya)", kind: Strait, a: 55, b: 56, shores: [423, 647], opened: None, regime: Some("No passage treaty found"), holders: [], source: "Natural Earth \'La Pérouse Strait\'; shores from assets/map/provinces.ron"),
