        (id: 21, key: "bering", name: "Bering Strait", kind: Strait, a: 57, b: 6, shores: [796, 665], opened: None, regime: Some("No passage treaty found"), holders: [], source: "shores from assets/map/provinces.ron (Alaska; Chukotka)"),
        (id: 22, key: "magellan", name: "Strait of Magellan", kind: Strait, a: 37, b: 62, shores: [111], opened: None, regime: Some("Chile–Argentina Boundary Treaty of 1881 (signed 1881-07-23), art. V: neutralised for ever, free navigation for all flags, no fortifications; confirmed by the Treaty of Peace and Friendship of 1984. WP \'Boundary treaty of 1881 between Chile and Argentina\'"), holders: [], source: "Natural Earth \'Estrecho de Magellanes\'; Magallanes in CHL-SUR; the way round Cape Horn stays an open contact"),
        (id: 23, key: "panama_canal", name: "Panama Canal", kind: Canal, a: 31, b: 60, shores: [575], opened: Some("1914-08-15"), regime: Some("Hay–Pauncefote Treaty (1901-11-18) and Hay–Bunau-Varilla Treaty (signed 1903-11-18, in force 1904-02-26): Canal Zone under US control, neutral, US may protect it (art. XXIII); Torrijos–Carter Treaties (signed 1977-09-07, in force 1979-10-01), canal to Panama on 1999-12-31. WP \'Hay–Bunau-Varilla Treaty\'; Avalon Project text; WP \'Torrijos–Carter Treaties\'. Opening: WP \'Panama Canal\' (SS Ancon, 1914-08-15)"), holders: [(tag: "USA", from: "1904-02-26", until: Some("1999-12-31"), source: "Canal Zone under United States control, with the rights of a sovereign and the right to protect the canal (Hay–Bunau-Varilla Treaty, in force 1904-02-26, arts. III and XXIII), until the transfer to Panama at noon on 1999-12-31 (Torrijos–Carter Treaties). WP \'Hay–Bunau-Varilla Treaty\'; Avalon Project text; WP \'Torrijos–Carter Treaties\'")], source: "the Canal Zone is not a state of the map: the shore is PAN and the United States hold it by treaty (docs/map-pipeline.pt-BR.md, \'Quem controla\')"),
