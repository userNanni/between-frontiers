// Economy catalogue: what the state, the investment pool and the builders buy, and the freight
// each building group pays. Format: bf_sim::economy::PurchasesFile. Shares are per mille of the
// money spent; the order of each list is the order the simulation buys in.
(
    // The state's goods budget.
    state: [
        ("services", 300),
        ("transportation", 100),
        ("paper", 100),
        ("medicines", 100),
        ("small_arms", 100),
        ("ammunition", 100),
        ("artillery", 50),
        ("warships", 100),
        ("military_aircraft", 50),
    ],
    // Upkeep and housing from the investment pool: the work of the building trade, and the
    // equipment that wears out with it. Structures were about three fifths of gross fixed
    // capital formation before the war and producer durables two fifths (docs/economy.pt-BR.md,
    // "Investimento").
    upkeep: [
        ("construction", 600),
        ("machinery", 250),
        ("electrical_equipment", 50),
        ("rolling_stock", 50),
        ("tools", 50),
    ],
    // Parts of a construction basket that are the building itself, made by the building trade
    // and delivered as construction points; the rest (machines, tools) is bought directly.
    building_work: ["services", "cement", "timber", "steel"],
    // Per building group. `construction`: one new level, half of it the work of building it
    // (bought as services), the rest materials and machines. `freight`: transport bought per
    // unit of output value at base prices, per mille. Bulk (ore, grain, steel) costs more to
    // move than its value suggests; services and power pay none (power moves by wire, and the
    // wire is the grid).
    // `research`: research and development the group's firms want, per mille of the value it
    // adds, paid out of the investment pool (docs/research.pt-BR.md, "Pesquisa que custa").
    // Scale: business-funded R&D in the United States was 0.58 % of GDP in 1953 and 1.08 % in
    // 1980 (NSF 25-326, table 1), almost all of it in manufacturing; the split between groups
    // is design, by how much of each group's technique is new (chemicals, electrical goods,
    // machines and aircraft against textiles and food), to calibrate on the scorecard.
    groups: [
        (
            group: "agriculture",
            construction: [("services", 500), ("tools", 200), ("timber", 250), ("cement", 50)],
            freight: 40,
        ),
        (
            group: "extraction",
            construction: [
                ("services", 450),
                ("machinery", 250),
                ("steel", 150),
                ("cement", 50),
                ("explosives", 100),
            ],
            freight: 60,
            // Geology and mining engineering: little.
            research: 2,
        ),
        (
            group: "heavy_industry",
            construction: [
                ("services", 450),
                ("steel", 150),
                ("cement", 70),
                ("machinery", 250),
                ("tools", 80),
            ],
            freight: 40,
            // Chemicals, electrical goods, machines, motors, vehicles: the research industries.
            research: 20,
        ),
        (
            group: "light_industry",
            construction: [
                ("services", 450),
                ("steel", 150),
                ("cement", 70),
                ("machinery", 250),
                ("tools", 80),
            ],
            freight: 25,
            // Textiles, food, paper, furniture: mostly mature technique; drugs and appliances raise it.
            research: 5,
        ),
        (
            group: "energy",
            construction: [
                ("services", 450),
                ("steel", 150),
                ("cement", 100),
                ("machinery", 150),
                ("electrical_equipment", 150),
            ],
            // Power plants and the grid.
            research: 5,
        ),
        (
            group: "infrastructure",
            construction: [
                ("services", 500),
                ("steel", 200),
                ("cement", 80),
                ("timber", 120),
                ("rolling_stock", 100),
            ],
        ),
        (
            group: "services",
            construction: [
                ("services", 600),
                ("cement", 80),
                ("timber", 150),
                ("furniture", 120),
                ("paper", 50),
            ],
        ),
        (
            group: "military_industry",
            construction: [
                ("services", 450),
                ("steel", 150),
                ("cement", 70),
                ("machinery", 250),
                ("tools", 80),
            ],
            freight: 25,
            // Arms, aircraft and warships: the most research per unit of output.
            research: 40,
        ),
    ],
    // Trade with a partner (docs/trade.pt-BR.md). Design values, to calibrate after phase 6.
    trade: (
        // Share of a surplus or a shortage that reaches the world in a week. It was 0.85 from the
        // phase-1 pool (#29), "so that local prices still carry part of the signal (distance,
        // ports, habits)", before freight and the partner's preference existed. Those now carry
        // that signal, and 0.85 left a weekly rest of shortage and surplus whose price gap became
        // margin (55 % of trade in 1925) and halved trade (docs/trade.pt-BR.md, section 14).
        reach: 1.0,
        // Substitution between origins (Armington), long run: about 5 (Head and Mayer, 2014,
        // Handbook of International Economics vol. 4).
        sigma: 5,
        // Share of the way a buyer's preference for a seller moves each month toward the cost
        // of arrival. The long-run elasticity is on average twice the short-run one (Gallaway,
        // McDaniel and Rivera, 2003, NAJEF 14): half the way in a period of the data, about 0.2
        // a month for a quarter; 1/6 (half-life of four months) is the design value.
        monthly_step: 0.1667,
        // International freight, as a share of the value, is the group's freight per mille
        // (`groups[..].freight`, a haul inside the country) times the effective km over this
        // reference.
        reference_km: 1000,
        // A tonne-km by sea costs about a third of one by land (design value).
        sea_per_land: 0.333,
        // Land route over the great circle between capitals (design value).
        land_detour: 1.2,
        // Gross trade (`trade_gross`): how much a buyer leans toward its own product against a
        // foreign one at the same cost of arrival. Calibrated so that world trade (exports plus
        // imports) is near 14.8 % of world GDP in 1925 (Klasing and Milionis, 2014).
        home_bias: 36.0,
        // Customs duties (`econ::customs`, switch `customs_duties` in data/rules.ron), each of the
        // owner's decisions a datum.
        customs: (
            // The duty goes to the treasury (CT3): the tariff on the value of what the country
            // imported from every partner, at base prices (`customs::imports_by_buyer`). Measured against the customs revenue over
            // imports of 1925 (`diplomacy.ron`, `tariffs`: the Clemens-Williamson measure).
            revenue: true,
            // How much less a country seeks abroad for a higher tariff, cut from the quantity
            // (`1 / (1 + e t)` of its shortage). Zero: the tariff works through the price of
            // arrival instead (CT4), in the preference between home and foreign sellers of gross
            // trade (sigma above). Measured at e = 1 (docs/trade.pt-BR.md, section 13): the cut
            // left demand unmet (0.7 to 1.5 points more where a country imports) and tradable
            // output fell about 1 % instead of moving to the producer at home, and world GDP lost
            // 4 % by 2022. Long-run price elasticities of imports run from about 0.3 to 1.6 among
            // the G-7 (Hooper, Johnson and Marquez, Princeton Studies in International Economics
            // 87, 2000); sigma = 5 gives the price channel its own.
            elasticity: 0.0,
            // Each country's 1925 rate of `diplomacy.ron` instead of the step of its trade law,
            // the law moving it from there (CT5).
            rates_1925: true,
        ),
    ),
)
