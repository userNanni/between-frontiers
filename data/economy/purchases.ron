// Economy catalogue: what the state, the investment pool and the builders buy, and the freight
// each building group pays. Format: bf_sim::economy::PurchasesFile. Shares are per mille of the
// money spent; the order of each list is the order the simulation buys in.
(
    // The state's goods budget.
    state: [
        ("services", 300),
        ("transportation", 100),
        ("paper", 100),
        ("medicines", 100),
        ("small_arms", 100),
        ("ammunition", 100),
        ("artillery", 50),
        ("warships", 100),
        ("military_aircraft", 50),
    ],
    // Upkeep and housing from the investment pool: the work of the building trade, and the
    // equipment that wears out with it. Structures were about three fifths of gross fixed
    // capital formation before the war and producer durables two fifths (docs/economy.pt-BR.md,
    // "Investimento").
    upkeep: [
        ("construction", 600),
        ("machinery", 250),
        ("electrical_equipment", 50),
        ("rolling_stock", 50),
        ("tools", 50),
    ],
    // Parts of a construction basket that are the building itself, made by the building trade
    // and delivered as construction points; the rest (machines, tools) is bought directly.
    building_work: ["services", "cement", "timber", "steel"],
    // Per building group. `construction`: one new level, half of it the work of building it
    // (bought as services), the rest materials and machines. `freight`: transport bought per
    // unit of output value at base prices, per mille. Bulk (ore, grain, steel) costs more to
    // move than its value suggests; services and power pay none (power moves by wire, and the
    // wire is the grid).
    // `research`: research and development the group's firms want, per mille of the value it
    // adds, paid out of the investment pool (docs/research.pt-BR.md, "Pesquisa que custa").
    // Scale: business-funded R&D in the United States was 0.58 % of GDP in 1953 and 1.08 % in
    // 1980 (NSF 25-326, table 1), almost all of it in manufacturing; the split between groups
    // is design, by how much of each group's technique is new (chemicals, electrical goods,
    // machines and aircraft against textiles and food), to calibrate on the scorecard.
    groups: [
        (
            group: "agriculture",
            construction: [("services", 500), ("tools", 200), ("timber", 250), ("cement", 50)],
            freight: 40,
        ),
        (
            group: "extraction",
            construction: [
                ("services", 450),
                ("machinery", 250),
                ("steel", 150),
                ("cement", 50),
                ("explosives", 100),
            ],
            freight: 60,
            // Geology and mining engineering: little.
            research: 2,
        ),
        (
            group: "heavy_industry",
            construction: [
                ("services", 450),
                ("steel", 150),
                ("cement", 70),
                ("machinery", 250),
                ("tools", 80),
            ],
            freight: 40,
            // Chemicals, electrical goods, machines, motors, vehicles: the research industries.
            research: 20,
        ),
        (
            group: "light_industry",
            construction: [
                ("services", 450),
                ("steel", 150),
                ("cement", 70),
                ("machinery", 250),
                ("tools", 80),
            ],
            freight: 25,
            // Textiles, food, paper, furniture: mostly mature technique; drugs and appliances raise it.
            research: 5,
        ),
        (
            group: "energy",
            construction: [
                ("services", 450),
                ("steel", 150),
                ("cement", 100),
                ("machinery", 150),
                ("electrical_equipment", 150),
            ],
            // Power plants and the grid.
            research: 5,
        ),
        (
            group: "infrastructure",
            construction: [
                ("services", 500),
                ("steel", 200),
                ("cement", 80),
                ("timber", 120),
                ("rolling_stock", 100),
            ],
        ),
        (
            group: "services",
            construction: [
                ("services", 600),
                ("cement", 80),
                ("timber", 150),
                ("furniture", 120),
                ("paper", 50),
            ],
        ),
        (
            group: "military_industry",
            construction: [
                ("services", 450),
                ("steel", 150),
                ("cement", 70),
                ("machinery", 250),
                ("tools", 80),
            ],
            freight: 25,
            // Arms, aircraft and warships: the most research per unit of output.
            research: 40,
        ),
    ],
)
