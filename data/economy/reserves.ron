// Monetary reserves for settlement in money and reserves (`econ::payments::settle`,
// `game::Switches::payments_settle`, docs/state.pt-BR.md, "Padrão-ouro, reservas e balanço de
// pagamentos", slice 2). Read only with the switch on.
//
// Sources:
// - gold_1925: Board of Governors of the Federal Reserve System, *Banking and Monetary
//   Statistics 1914–1941* (Washington, 1943), Table 160, "Gold reserves of central banks and
//   governments", pp. 544–551, row "1925—Dec.", in millions of dollars with gold at $20.67 per
//   fine ounce. Scanned on FRASER (Federal Reserve Bank of St. Louis),
//   https://fraser.stlouisfed.org/title/banking-monetary-statistics-1914-1941-38 (file
//   BMS14-41_complete.pdf). A publication of the US government: public domain.
//   The table's colonies go to the market that holds them in the scenario: Algeria and Morocco
//   to France, Java (the Netherlands Indies) to the Netherlands. Countries with no figure for
//   December 1925 in the table start with no gold: China, Ecuador (from 1927), Guatemala
//   (from 1926), Danzig, Albania, Turkey, Siam, Persia and the Belgian Congo (from 1927).
//   Foreign exchange held by central banks is not in the table: it is in `fx_1925` below.
// - monetary_share: League of Nations, *Report of the Gold Delegation of the Financial
//   Committee* (Geneva, 1932), §121(a): "in the four years 1926 to 1929 somewhat more than $250
//   million of gold per annum were added to the visible monetary stocks ... rather less than
//   $150 million remained for non-monetary consumption", that is 250 of some 400 million a year
//   of new gold. Scanned by the National Library of Scotland,
//   https://deriv.nls.uk/dcn23/1903/6301/190363014.23.pdf. Public domain (League of Nations,
//   1932).
//
// The gold is valued at the catalogue's base price of the good `gold`: millions of dollars over
// `dollars_per_kg` ($20.67 an ounce × 32.1507 troy ounces in a kilogram) give the kilograms.
(
    dollars_per_kg: 664.556,
    // Per mille of each country's mine output that goes to its central bank.
    monetary_share: 625,
    gold_1925: [
        ("USA", 3985.4),
        ("FRA", 5.9), // Algeria
        ("ARG", 450.6),
        ("AUS", 162.5),
        ("AUT", 2.1),
        ("BEL", 52.9),
        ("BOL", 6.6),
        ("BRA", 54.3),
        ("RAJ", 108.6), // British India
        ("BUL", 8.0),
        ("CAN", 156.8),
        ("CHL", 34.0),
        ("COL", 14.6),
        ("CZE", 27.1),
        ("DEN", 56.1),
        ("EGY", 16.6),
        ("SAL", 5.4),
        ("EST", 1.3),
        ("FIN", 8.4),
        ("FRA", 711.0),
        ("GER", 287.8),
        ("GRE", 12.7),
        ("HUN", 10.4),
        ("ISL", 0.6),
        ("ITA", 221.6),
        ("JAP", 575.8),
        ("NLD", 73.4), // Java
        ("LAT", 4.5),
        ("LTU", 3.2),
        ("MEX", 16.7),
        ("FRA", 0.4), // Morocco
        ("NLD", 178.7),
        ("NZL", 37.7),
        ("NOR", 39.5),
        ("PER", 21.5),
        ("POL", 25.8),
        ("POR", 9.3),
        ("ROM", 48.5),
        ("SAF", 43.6),
        ("ESP", 489.5),
        ("SWE", 61.6),
        ("CHE", 90.5),
        ("GBR", 694.8),
        ("URY", 56.8),
        ("SOV", 93.9),
        ("VEN", 16.4),
        ("YUG", 14.7),
    ],
    // Foreign exchange held by the central banks at the end of 1925 (holder, issuer, millions of
    // dollars at the December 1925 New York rate). The amounts are read on the page: League of
    // Nations, *Statistical Year-Book 1928* (Geneva, 1929), Table 96, "Gold and Foreign Assets
    // Reserves", pp. 186–189 (archive.org in.ernet.dli.2015.99146), and *Federal Reserve
    // Bulletin*, February 1926, pp. 120–122, and March 1926, pp. 190–192 (FRASER), the column
    // of exchange the banks counted as reserve (Germany's 403 million marks of Deckungsdevisen,
    // not the 1,016 of all foreign assets); rates from *Banking and Monetary Statistics
    // 1914–1941*, Table 173. India's is the Paper Currency Reserve's sterling (the note cover),
    // not all its sterling assets (411); Italy's takes the low end of an unresolved unit (27.9
    // to 36.5). The pounds of Australia, South Africa and Egypt and the Baltic currencies are
    // converted at sterling or their parity (estimates).
    // NOT READ FROM A SOURCE (estimate): the issuer. The sources give the exchange in one sum;
    // the empire, Scandinavia, the League's loan countries (Austria, Hungary, Greece) and
    // Portugal and Egypt are put in sterling, the countries stabilized with American loans
    // (Germany's Dawes loan, Poland, Italy, Belgium) in dollars, and the rest half and half.
    // No figure: the United Kingdom and the United States held no exchange as reserve; Canada,
    // Argentina and New Zealand had no central bank; Chile's opened in January 1926; Romania's
    // has no line; Japan's and Estonia's come summed with gold.
    fx_1925: [
        ("GER", "USA", 95.9),
        ("FRA", "GBR", 5.9), ("FRA", "USA", 5.9),
        ("ITA", "USA", 27.9),
        ("NLD", "GBR", 49.65), ("NLD", "USA", 49.65),
        ("BEL", "USA", 5.8),
        ("CHE", "GBR", 5.9), ("CHE", "USA", 5.9),
        ("SWE", "GBR", 27.2), ("SWE", "USA", 27.2),
        ("NOR", "GBR", 11.2),
        ("DEN", "GBR", 22.4),
        ("AUT", "GBR", 78.5),
        ("HUN", "GBR", 36.2),
        ("CZE", "GBR", 17.75), ("CZE", "USA", 17.75),
        ("POL", "USA", 7.6),
        ("RAJ", "GBR", 140.6),
        ("AUS", "GBR", 89.2),
        ("SAF", "GBR", 30.6),
        ("BRA", "GBR", 20.7),
        ("FIN", "GBR", 38.1),
        ("ESP", "GBR", 2.05), ("ESP", "USA", 2.05),
        ("YUG", "GBR", 3.25), ("YUG", "USA", 3.25),
        ("BUL", "GBR", 1.85), ("BUL", "USA", 1.85),
        ("GRE", "GBR", 14.4),
        ("LAT", "GBR", 6.0),
        ("LTU", "GBR", 1.5), ("LTU", "USA", 1.5),
        ("POR", "GBR", 2.7),
        ("EGY", "GBR", 209.8),
    ],
    // The monetary base at the end of 1925, millions of dollars: notes in circulation and the
    // bank of issue's sight liabilities, from the same tables (and Table 95, "Note Circulation",
    // pp. 183–185; *Banking and Monetary Statistics*, Tables 93, 164, 165 and 167). The Bank of
    // England's own notes and deposits (1,249), not the Treasury's currency notes (another
    // 1,441), which the Bank Act did not cover; the Federal Reserve's notes and deposits. Where
    // the sources give no deposits (India, Australia, Canada, Argentina, Brazil, Chile, Egypt,
    // Estonia, New Zealand) the notes alone.
    base_1925: [
        ("GBR", 1249.0), ("GER", 871.0), ("FRA", 2037.0), ("USA", 4099.0), ("ITA", 879.0),
        ("NLD", 369.0), ("BEL", 364.0), ("CHE", 194.0), ("SWE", 216.0), ("NOR", 92.0),
        ("DEN", 126.0), ("AUT", 133.0), ("HUN", 110.0), ("CZE", 271.0), ("POL", 52.3),
        ("JAP", 844.0), ("RAJ", 703.0), ("AUS", 241.0), ("SAF", 73.3), ("CAN", 227.0),
        ("ARG", 547.0), ("BRA", 384.0), ("CHL", 47.9), ("FIN", 54.7), ("ESP", 807.0),
        ("ROM", 133.0), ("YUG", 114.0), ("BUL", 45.6), ("GRE", 117.0), ("EST", 9.4),
        ("LAT", 29.7), ("LTU", 10.6), ("POR", 90.3), ("EGY", 167.0), ("NZL", 33.5),
    ],
)
