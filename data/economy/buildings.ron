            (key: "automatic_exchange", available_from: 1925, inputs: [("copper", 40), ("electrical_equipment", 40), ("electricity", 1500)], outputs: [("telecommunications", 6000)], jobs: [("clerk", 300), ("skilled_worker", 300), ("engineer", 60), ("manager", 20), ("capitalist", 5)]),
