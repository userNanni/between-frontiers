        ]),
        // The building trade: turns materials and labour into construction points for the queue
        // of works (docs/state.pt-BR.md). Every new level waits for its points.
        (key: "construction_sector", group: "infrastructure", resource: None, farm: None, methods: [
            (key: "hand_construction", available_from: 1925, inputs: [("timber", 6000), ("cement", 780), ("steel", 200), ("tools", 80)], outputs: [("construction", 9000)], jobs: [("laborer", 750), ("skilled_worker", 150), ("engineer", 10), ("clerk", 50), ("manager", 25), ("capitalist", 5)]),
            (key: "mechanized_construction", available_from: 1925, inputs: [("timber", 5000), ("cement", 1560), ("steel", 500), ("machinery", 50), ("fuel", 800), ("tools", 50)], outputs: [("construction", 16000)], jobs: [("laborer", 400), ("skilled_worker", 300), ("engineer", 30), ("clerk", 60), ("manager", 25), ("capitalist", 5)]),
        ]),
        // City housing: rented by the urban professions (need `urban_housing`), built by private
        // capital and by the state. Its capacity limits migration to the city.
        (key: "urban_housing", group: "services", resource: None, farm: None, methods: [
            (key: "tenements", available_from: 1925, inputs: [("timber", 300), ("cement", 39)], outputs: [("housing", 5000)], jobs: [("laborer", 20), ("skilled_worker", 5), ("clerk", 5)]),
        ]),
        // Public services: the state builds them, buys all they make and pays all their value
        // added as wages. Schools speed literacy, hospitals lower mortality.
        (key: "school", group: "services", resource: None, farm: None, public: true, methods: [
            (key: "classroom", available_from: 1925, inputs: [("paper", 20), ("furniture", 20), ("services", 50)], outputs: [("schooling", 24000)], jobs: [("professional", 800), ("clerk", 100), ("laborer", 100)]),
        ]),
        (key: "hospital", group: "services", resource: None, farm: None, public: true, methods: [
