            (key: "arsenal", available_from: 1925, inputs: [("steel", 360), ("engines", 500), ("ferroalloys", 200), ("electrical_equipment", 100)], outputs: [("warships", 10220)], jobs: [("laborer", 500), ("skilled_worker", 350), ("engineer", 40), ("clerk", 50), ("manager", 15), ("capitalist", 5)]),
