        (key: "research", category: "public", base_price: 1000, available_from: 1925, tradable: false, unit: "lot worth $1,000 of research and development"),
        // Appended last: goods are indexed by their place in this list, and saves keep per-good
        // lists (`econ::compat::fit_goods`).
        // Secondary and higher education: one student taught for a year. Prices are what the
        // buildings cost to run per student (docs/population.pt-BR.md, "Ensino por coorte").
        (key: "secondary_schooling", category: "public", base_price: 540, available_from: 1925, tradable: false, unit: "one secondary pupil taught for a year"),
        (key: "higher_education", category: "public", base_price: 1500, available_from: 1925, tradable: false, unit: "one student in higher education taught for a year"),
        // U2 (the owner, 2026-11-19): one good of weapon fissile, counted in cores, made by two
        // methods (weapon_core_plant); a core is the fissile of a first-generation weapon. The
        // base price is an estimate: above what the 1945 high enrichment spends on a core at base
        // prices (about 254 million, mostly electricity), so the first method makes no loss at
        // base prices; the production reactor spends far less, and the market sets the price.
        (key: "weapon_cores", category: "military", base_price: 300000000, available_from: 1944, tradable: false, unit: "1 fission core"),
        // The assembly of the warhead (the step between the core and the weapon; Hewlett and
        // Duncan, Atomic Shield 1947-1952, 1969, pp. 47 and 134): the non-nuclear assembly of one
        // warhead (the explosive lenses, the initiator, the fuzing and firing, the case), made by
        // the weapon_assembly_plant. It is a good because the warhead is a formation built from
        // goods, not the product of a building. The base price is an estimate: above the inputs
        // (about 54,000) and the wages of a level over its yearly output at base prices.
        (key: "weapon_assemblies", category: "military", base_price: 200000, available_from: 1945, tradable: false, unit: "the non-nuclear assembly of one warhead"),
    ],
)
