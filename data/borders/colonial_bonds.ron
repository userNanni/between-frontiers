// Between Frontiers: the bond of each colonial unit to its owner on 1925-01-01
// (docs/borders.pt-BR.md, section 11, decision I2 of 2026-11-18). Licence: CC BY-SA 4.0.
//
// The kind is the same `SubjectKind` as the subjects' (countries.ron): a concession of self-rule
// holds for every unit of the owner with the same kind, and not for the other kinds (the French
// loi-cadre of 1956 for Black Africa, not for the departments of Algeria nor for the protectorates
// of Morocco and Tunisia). A unit that spans several kinds takes the kind of most of its people,
// noted. A condominium is read as a protectorate. A unit missing here is a crown colony.
(
    bonds: [
        (unit: "PNG", kind: Mandate, source: "WP 'Territory of New Guinea' (League mandate C, 1920) and 'Territory of Papua'", note: Some("most of the unit's people under the mandate")),
        (unit: "BDI", kind: Mandate, source: "WP 'Ruanda-Urundi' (League mandate B, 1922)"),
        (unit: "COD", kind: CrownColony, source: "WP 'Belgian Congo' (colony from 1908)"),
        (unit: "GNQ", kind: CrownColony, source: "WP 'Spanish Guinea'"),
        (unit: "BEN", kind: CrownColony, source: "WP 'French Dahomey' (colony of French West Africa)"),
        (unit: "BFA", kind: CrownColony, source: "WP 'French Upper Volta' (colony of French West Africa, 1919)"),
        (unit: "CAF", kind: CrownColony, source: "WP 'Ubangi-Shari' (colony of French Equatorial Africa)"),
        (unit: "CIV", kind: CrownColony, source: "WP 'French Ivory Coast'"),
        (unit: "CMR", kind: Mandate, source: "WP 'French Cameroon' (League mandate B, 1922)"),
        (unit: "COG", kind: CrownColony, source: "WP 'French Congo' (Middle Congo, French Equatorial Africa)"),
        (unit: "COM", kind: CrownColony, source: "WP 'Comoros (French colony)' (attached to Madagascar, 1912)"),
        (unit: "DJI", kind: CrownColony, source: "WP 'French Somaliland'"),
        (unit: "GAB", kind: CrownColony, source: "WP 'French Gabon'"),
        (unit: "GIN", kind: CrownColony, source: "WP 'French Guinea'"),
        (unit: "KHM", kind: Protectorate, source: "WP 'French protectorate of Cambodia'"),
        (unit: "LAO", kind: Protectorate, source: "WP 'French protectorate of Laos'"),
        (unit: "LBN", kind: Mandate, source: "WP 'Mandate for Syria and the Lebanon' (League mandate A, 1923)"),
        (unit: "MDG", kind: CrownColony, source: "WP 'Colony of Madagascar and Dependencies'"),
        (unit: "MLI", kind: CrownColony, source: "WP 'French Sudan' (colony of French West Africa)"),
        (unit: "MRT", kind: CrownColony, source: "WP 'Colonial Mauritania' (colony from 1920)"),
        (unit: "NER", kind: CrownColony, source: "WP 'Colony of Niger' (military territory, colony from 1922)"),
        (unit: "SEN", kind: CrownColony, source: "WP 'French Senegal'"),
        (unit: "TCD", kind: CrownColony, source: "WP 'French Chad' (colony from 1920)"),
        (unit: "TGO", kind: Mandate, source: "WP 'French Togoland' (League mandate B, 1922)"),
        (unit: "TUN", kind: Protectorate, source: "WP 'French protectorate of Tunisia'"),
        (unit: "VNM", kind: Protectorate, source: "WP 'French Indochina' (Annam and Tonkin protectorates, Cochinchina colony)", note: Some("most of the unit's people in the protectorates of Annam and Tonkin")),
        (unit: "DZA", kind: Integrated, source: "WP 'French Algeria' (three départements of France from 1848)"),
        (unit: "MAR", kind: Protectorate, source: "WP 'French protectorate in Morocco' (Treaty of Fez, 1912)"),
        (unit: "SYR", kind: Mandate, source: "WP 'Mandate for Syria and the Lebanon' (League mandate A, 1923)"),
        (unit: "ARE", kind: Protectorate, source: "WP 'Trucial States' (British protected states, treaties of 1820-1892)"),
        (unit: "BHR", kind: Protectorate, source: "WP 'Bahrain' (British protected state, 1861-1971)"),
        (unit: "BHS", kind: CrownColony, source: "WP 'Colony of the Bahamas'"),
        (unit: "BLZ", kind: CrownColony, source: "WP 'British Honduras' (crown colony from 1871)"),
        (unit: "BRB", kind: CrownColony, source: "WP 'Colony of Barbados'"),
        (unit: "BRN", kind: Protectorate, source: "WP 'Brunei (protectorate)' (British protectorate, 1888)"),
        (unit: "BWA", kind: Protectorate, source: "WP 'Bechuanaland Protectorate'"),
        (unit: "CYP", kind: CrownColony, source: "WP 'British Cyprus' (crown colony from 1925-05-01)"),
        (unit: "DMA", kind: CrownColony, source: "WP 'British Leeward Islands' (Dominica, colony)"),
        (unit: "FJI", kind: CrownColony, source: "WP 'Colony of Fiji'"),
        (unit: "GMB", kind: CrownColony, source: "WP 'Gambia Colony and Protectorate'"),
        (unit: "GUY", kind: CrownColony, source: "WP 'British Guiana'"),
        (unit: "ISR", kind: Mandate, source: "WP 'Mandatory Palestine' (League mandate A, 1923)"),
        (unit: "JAM", kind: CrownColony, source: "WP 'Colony of Jamaica'"),
        (unit: "LCA", kind: CrownColony, source: "WP 'British Windward Islands' (Saint Lucia, colony)"),
        (unit: "LSO", kind: CrownColony, source: "WP 'Basutoland' (crown colony, a High Commission Territory, 1884)"),
        (unit: "MLT", kind: CrownColony, source: "WP 'Crown Colony of Malta' (self-government from 1921)", note: Some("self-government of 1921 under the 1921 constitution")),
        (unit: "MUS", kind: CrownColony, source: "WP 'British Mauritius'"),
        (unit: "MWI", kind: Protectorate, source: "WP 'Nyasaland' (British protectorate)"),
        (unit: "QAT", kind: Protectorate, source: "WP 'Qatar' (British protected state, treaty of 1916)"),
        (unit: "SLB", kind: Protectorate, source: "WP 'British Solomon Islands Protectorate'"),
        (unit: "SLE", kind: Protectorate, source: "WP 'Sierra Leone Colony and Protectorate'", note: Some("most of the unit's people in the protectorate")),
        (unit: "SML", kind: Protectorate, source: "WP 'British Somaliland' (protectorate)"),
        (unit: "SWZ", kind: Protectorate, source: "WP 'Swaziland' (British protectorate, a High Commission Territory, 1903)"),
        (unit: "TON", kind: Protectorate, source: "WP 'Tonga' (British protected state, treaty of 1900)"),
        (unit: "TTO", kind: CrownColony, source: "WP 'Colony of Trinidad and Tobago'"),
        (unit: "TZA", kind: Mandate, source: "WP 'Tanganyika Territory' (League mandate B, 1922)"),
        (unit: "VUT", kind: Protectorate, source: "WP 'New Hebrides' (Anglo-French condominium, 1906)", note: Some("a condominium, read as a protectorate")),
        (unit: "ZMB", kind: Protectorate, source: "WP 'Northern Rhodesia' (British protectorate from 1924)"),
        (unit: "ZWE", kind: CrownColony, source: "WP 'Southern Rhodesia' (self-governing colony from 1923)", note: Some("responsible government of 1923")),
        (unit: "KEN", kind: CrownColony, source: "WP 'Kenya Colony' (colony and protectorate, 1920)"),
        (unit: "GHA", kind: CrownColony, source: "WP 'Gold Coast (British colony)'"),
        (unit: "UGA", kind: Protectorate, source: "WP 'Uganda Protectorate'"),
        (unit: "MYS", kind: Protectorate, source: "WP 'British Malaya' (Federated and Unfederated Malay States, Straits Settlements)", note: Some("most of the unit's people in the Malay States")),
        (unit: "NGA", kind: Protectorate, source: "WP 'Colony and Protectorate of Nigeria' (1914)", note: Some("most of the unit's people in the protectorate")),
        (unit: "LKA", kind: CrownColony, source: "WP 'British Ceylon'"),
        (unit: "SDN", kind: Protectorate, source: "WP 'Anglo-Egyptian Sudan' (condominium, 1899)", note: Some("a condominium, read as a protectorate")),
        (unit: "ERI", kind: CrownColony, source: "WP 'Italian Eritrea'"),
        (unit: "SOM", kind: CrownColony, source: "WP 'Italian Somaliland'"),
        (unit: "LBY", kind: CrownColony, source: "WP 'Italian Libya' (colonies of Tripolitania and Cyrenaica)"),
        (unit: "TWN", kind: CrownColony, source: "WP 'Taiwan under Japanese rule' (Government-General)"),
        (unit: "PRK", kind: CrownColony, source: "WP 'Korea under Japanese rule' (Government-General of Chōsen, 1910)"),
        (unit: "KOR", kind: CrownColony, source: "WP 'Korea under Japanese rule' (Government-General of Chōsen, 1910)"),
        (unit: "SUR", kind: CrownColony, source: "WP 'Surinam (Dutch colony)'"),
        (unit: "IDN", kind: CrownColony, source: "WP 'Dutch East Indies'"),
        (unit: "WSM", kind: Mandate, source: "WP 'Western Samoa Trust Territory' (League mandate C, 1920)"),
        (unit: "AGO", kind: CrownColony, source: "WP 'Portuguese Angola' (colony; overseas province only from 1951)"),
        (unit: "CPV", kind: CrownColony, source: "WP 'Portuguese Cape Verde' (colony; overseas province only from 1951)"),
        (unit: "GNB", kind: CrownColony, source: "WP 'Portuguese Guinea' (colony)"),
        (unit: "STP", kind: CrownColony, source: "WP 'Portuguese São Tomé and Príncipe' (colony)"),
        (unit: "TLS", kind: CrownColony, source: "WP 'Portuguese Timor' (colony)"),
        (unit: "MOZ", kind: CrownColony, source: "WP 'Portuguese Mozambique' (colony)"),
        (unit: "NAM", kind: Mandate, source: "WP 'South West Africa' (League mandate C, 1920)"),
        (unit: "PHL", kind: CrownColony, source: "WP 'Insular Government of the Philippine Islands' (unincorporated territory)"),
    ],
)
