// Rules of the game that a PR adds switched off (`game::Switches`). A rule that changes every
// country's numbers enters here off, so that the main keeps its hash; switching it on is a PR of
// its own, judged by the world's aggregates (owner's decision of 2026-11-17,
// `docs/wiki/principios.md`, "Regra que muda o mundo inteiro entra desligada"). A field missing
// here is off; an unknown one is an error.
//
// Over this file: `BF_RULES=a,b` when the data load (game, tests, screenshots) and
// `bf-bench --rule NAME` (repeatable) for a run.
//
// In alphabetical order, as `game::Switches`: a new rule goes in its place, not at the end.
(
    // The monthly step of the agreements in force (`docs/treaties.pt-BR.md`, "o teste mensal"):
    // tribute paid and tested, and an agreement with a fixed term ends when it runs out.
    // Off: nothing is paid and agreements never end by their term.
    clause_tests: false,
    // Crises and declaration (`docs/war.pt-BR.md`, "Crise e declaração"): a demand with a
    // deadline, the AI answering by the force against the share asked for, war on a refusal.
    // Needs `forces`. Off: no crisis opens.
    crisis: false,
    // The servants' capacity to collect (`docs/state.pt-BR.md`, D1, owner's decision O1): a
    // region with fewer servants than the rule asks for collects that much less tax.
    fiscal_capacity: false,
    // Armed forces in peace (`docs/war.pt-BR.md`, "Forças em paz"): the soldiers are the men of
    // the formations of `data/scenario/1925/forces.ron`. Off: the old rule of
    // `data/military/peace.ron` (`soldiers`). On since the PR that switched it, judged by the
    // eight-sample band of main (docs/war.pt-BR.md, "Chave").
    forces: true,
    // The contract and the expropriation of foreign plants (`docs/foreign-capital.pt-BR.md`, step
    // 4a): the colony's plants stay the old metropole's at independence, and on January 1st a
    // host whose laws close the capital or plan the economy takes them. Off: no such stake.
    foreign_contract: false,
    // Capital crosses borders (`docs/foreign-capital.pt-BR.md`): the funds build abroad with what
    // they have left at home; the stakes and the weekly remittance follow from what they build.
    foreign_flow: false,
    // Technique through the foreign plant (`docs/foreign-capital.pt-BR.md`, C5): imitation and
    // diffusion run faster where foreign owners hold the levels a technology serves. Off: the
    // foreign plants teach nothing.
    foreign_technique: false,
    // Independence by movement (`docs/borders.pt-BR.md`, section 11): colonial units demand an
    // answer, the metropole answers by its measured account, a refusal can end in revolt. Off:
    // colonies only grow their movement.
    independence: false,
    // The influence's trade and investment channels (`docs/influence.pt-BR.md`, 13c): what B sells
    // to A and what A owns in B weigh in A's influence over B. Off: both channels stay dormant.
    influence_ties: false,
    // Jobs follow use (`econ::monthly::LAYOFF_PER_MONTH`): a plant that sells less than it could
    // make lays off part of its crew each month. Off: every level employs its full crew.
    jobs_follow_use: false,
    // The record of each line of the ledger of debts between governments
    // (`docs/treaties.pt-BR.md`, "o registro de cada linha"): what was paid and written off, and a
    // line that ends stays closed in the record. Off: a line that ends leaves the ledger.
    ledger_record: false,
    // The negotiation table (`docs/treaties.pt-BR.md` section 13): proposals answered by the AI
    // in the first week by the account the player sees, counterproposals and denunciations.
    // Off: proposals wait on the table.
    negotiation: false,
    // The reputation of each country's breaches (`docs/treaties.pt-BR.md` 9.4, the owner's
    // decisions P1–P3 of 2026-11-18): security and general, a tenth forgotten a year, halved by a
    // change of regime, read by the table. Off: breaches give causes, nothing more.
    reputation: false,
    // Schooling by cohort and level, and the adult literacy campaign
    // (`docs/population.pt-BR.md`, "Ensino por coorte"). Off: literacy follows the economy's
    // yearly rule and mothers' schooling the 240-month lag.
    schooling: false,
    // The wage floor of a small market (`econ::monthly::MIN_HANDS_FOR_A_WAGE`): a market with too
    // few plant workers to have a wage of its own reads the lowest of the others.
    small_market_wage_floor: false,
    // Trade by pair (`docs/trade.pt-BR.md`): each buyer splits what it seeks among the sellers by
    // the cost of arrival. Off: the world pool shares trade pro rata. On since the PR that switched
    // it, judged by the eight-sample band of main (docs/trade.pt-BR.md, section 8a).
    trade_by_pair: true,
    // The treaties of 1925 in force as agreements (`docs/treaties.pt-BR.md`, "acordos em
    // vigor"): their clauses call third parties into a crisis and a breach is recorded against
    // them. On since the PR that switched it (judged by the aggregates of the band); off, only
    // the agreements signed in play are kept.
    treaties_in_force: true,
    // Services across a customs union in force (`docs/trade.pt-BR.md`, section 12): between two
    // countries bound by the customs union clause of an agreement in force, services and
    // finance trade by pair (the microstates' economy). Needs `trade_by_pair`, and the 1925
    // unions need `treaties_in_force`. Off: services are sold only at home.
    union_services: false,
)
