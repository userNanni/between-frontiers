// Between Frontiers: laws in force on 1925-01-01. Contract: crates/bf-sim/src/politics.rs
// (ScenarioLawsFile); catalogue in data/politics/laws.ron. Method, sources and confidence:
// data/scenario/1925/LAWS.md. Licence: CC BY-SA 4.0.
//
// Every country takes a template and overrides it group by group; `source` names the acts and
// constitutions behind each choice (facts of law, not text from any database). The law is what
// the statute book said, not how it was enforced: where the two differ a lot, the source says so.
// Countries with colonies (countries.ron `colonies: Some`) also hold the two colonial groups.
//
// Targeted laws (official_nationality, legal_segregation, theocratic_law, state_atheism,
// pass_laws, racial_exclusion) leave `targets` empty until the community catalogue exists; the
// source says in words whom they target.
//
// `history` lists dated changes after the start, as reference for calibration and for the AI.
// Nothing fires them.
(
    templates: [
        (
            // Parliamentary democracies of Western, Northern and Central Europe.
            key: "parliamentary_europe",
            laws: [
                "progressive_income_tax", "regulated_market", "freehold_farming", "protective_tariffs",
                "open_capital", "collective_bargaining", "eight_hour_day", "workers_insurance",
                "health_insurance", "compulsory_primary", "universal_suffrage", "equal_citizenship",
                "state_church", "free_movement", "open_immigration", "free_emigration", "free_press",
                "public_broadcaster", "civil_liberties", "merit_service", "universal_service",
            ],
        ),
        (
            // Self-governing dominions of the British Empire.
            key: "dominion",
            laws: [
                "progressive_income_tax", "regulated_market", "freehold_farming", "protective_tariffs",
                "open_capital", "collective_bargaining", "factory_acts", "workers_insurance",
                "public_hospitals", "compulsory_primary", "universal_suffrage", "equal_citizenship",
                "separation", "free_movement", "racial_exclusion", "free_emigration", "free_press",
                "private_broadcasting", "civil_liberties", "merit_service", "volunteer_army",
            ],
        ),
        (
            // Kingdoms and republics of East-Central and South-Eastern Europe after the land
            // reforms of 1918–1923.
            key: "eastern_europe",
            laws: [
                "proportional_income_tax", "regulated_market", "land_reform", "protective_tariffs",
                "screened_capital", "unions_tolerated", "factory_acts", "workers_insurance",
                "public_hospitals", "compulsory_primary", "male_suffrage", "equal_citizenship",
                "state_church", "free_movement", "open_immigration", "free_emigration",
                "press_licensing", "state_broadcasting", "emergency_powers", "patronage",
                "universal_service",
            ],
        ),
        (
            // Oligarchic republics of Latin America (and Liberia).
            key: "latin_republic",
            laws: [
                "indirect_taxation", "laissez_faire", "great_estates", "revenue_tariffs", "open_capital",
                "unions_tolerated", "unregulated_labour", "poor_relief", "private_medicine",
                "compulsory_primary", "restricted_suffrage", "equal_citizenship", "state_church",
                "free_movement", "open_immigration", "free_emigration", "free_press",
                "private_broadcasting", "civil_liberties", "patronage", "selective_service",
            ],
        ),
        (
            // Absolute and religious monarchies of Asia and Africa.
            key: "traditional_monarchy",
            laws: [
                "indirect_taxation", "laissez_faire", "great_estates", "revenue_tariffs", "open_capital",
                "unions_banned", "unregulated_labour", "family_and_charity", "private_medicine",
                "traditional_schooling", "no_free_elections", "equal_citizenship", "theocratic_law",
                "free_movement", "open_immigration", "free_emigration", "prior_censorship",
                "state_broadcasting", "emergency_powers", "patronage", "volunteer_army",
            ],
        ),
        (
            // The Soviet Union under the New Economic Policy, and its satellites.
            key: "soviet",
            laws: [
                "progressive_income_tax", "state_capitalism", "land_reform", "autarky",
                "screened_capital", "state_unions", "labour_code", "workers_insurance",
