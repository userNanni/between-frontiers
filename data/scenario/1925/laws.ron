            // European microstates.
            key: "microstate",
            laws: [
                "indirect_taxation", "laissez_faire", "freehold_farming", "revenue_tariffs",
                "open_capital", "unions_tolerated", "factory_acts", "poor_relief", "private_medicine",
                "compulsory_primary", "restricted_suffrage", "equal_citizenship", "state_church",
                "free_movement", "quota_immigration", "free_emigration", "free_press",
