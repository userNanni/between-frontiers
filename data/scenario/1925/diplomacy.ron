        (key: "franco_polish_alliance", kind: DefensiveAlliance, parties: ["FRA", "POL"], signed: "1921-02-19", in_force: "1921-02-19", source: "WP 'Franco-Polish alliance (1921)'; political agreement and secret military convention"),
        (key: "polish_romanian_alliance", kind: DefensiveAlliance, parties: ["POL", "ROM"], signed: "1921-03-03", in_force: "1921-03-03", source: "WP 'Polish-Romanian alliance'; LNTS. In force taken at signature"),
        (key: "franco_belgian_accord", kind: DefensiveAlliance, parties: ["FRA", "BEL"], signed: "1920-09-07", in_force: "1920-09-07", source: "WP 'Franco-Belgian Accord' (military agreement of 1920)"),
        (key: "franco_czechoslovak_alliance", kind: DefensiveAlliance, parties: ["FRA", "CZE"], signed: "1924-01-25", in_force: "1924-01-25", source: "WP 'Franco-Czechoslovak alliance'; LNTS"),
        (key: "estonian_latvian_alliance", kind: DefensiveAlliance, parties: ["EST", "LAT"], signed: "1923-11-01", in_force: "1923-11-01", source: "WP 'Baltic Entente' (Estonian-Latvian defensive treaty of 1923); LNTS"),
        (key: "pact_of_rome", kind: Friendship, parties: ["ITA", "YUG"], signed: "1924-01-27", in_force: "1924-01-27", source: "WP 'Treaty of Rome (1924)'; LNTS"),
        // ---- The Pacific settlement of Washington ----
        (key: "four_power_treaty", kind: Consultation, parties: ["USA", "GBR", "FRA", "JAP"], signed: "1921-12-13", in_force: "1923-08-17", source: "WP 'Four-Power Treaty'; ended the Anglo-Japanese Alliance on entry into force"),
        (key: "washington_naval_treaty", kind: ArmsLimitation, parties: ["USA", "GBR", "JAP", "FRA", "ITA"], signed: "1922-02-06", in_force: "1923-08-17", until: Some("1936-12-31"), source: "WP 'Washington Naval Treaty'"),
        (key: "nine_power_treaty", kind: Guarantee, parties: ["CHN", "USA", "GBR", "FRA", "ITA", "JAP", "BEL", "NLD", "POR"], senior: ["USA", "GBR", "FRA", "ITA", "JAP", "BEL", "NLD", "POR"], signed: "1922-02-06", in_force: "1925-08-05", source: "WP 'Nine-Power Treaty' (integrity of China, open door)"),
        // ---- Germany and the Soviet Union ----
        (key: "treaty_of_rapallo", kind: Friendship, parties: ["GER", "SOV"], signed: "1922-04-16", in_force: "1922-04-16", source: "WP 'Treaty of Rapallo (1922)'; LNTS. In force taken at signature"),
        (key: "treaty_of_berlin_1926", kind: Friendship, parties: ["GER", "SOV"], signed: "1926-04-24", in_force: "1926-06-29", source: "WP 'Treaty of Berlin (1926)' (neutrality)"),
        // ---- Locarno (signed after the start date) ----
        (key: "locarno_rhineland_pact", kind: Guarantee, parties: ["GER", "FRA", "BEL", "GBR", "ITA"], senior: ["GBR", "ITA"], signed: "1925-12-01", in_force: "1926-09-14", until: Some("1936-03-07"), source: "WP 'Locarno Treaties': initialled 1925-10-16, signed in London 1925-12-01, in force with Germany's entry into the League; denounced by Germany 1936-03-07"),
        (key: "locarno_franco_polish", kind: DefensiveAlliance, parties: ["FRA", "POL"], signed: "1925-12-01", in_force: "1926-09-14", source: "WP 'Locarno Treaties' (Franco-Polish treaty of mutual guarantee)"),
        (key: "locarno_franco_czechoslovak", kind: DefensiveAlliance, parties: ["FRA", "CZE"], signed: "1925-12-01", in_force: "1926-09-14", source: "WP 'Locarno Treaties' (Franco-Czechoslovak treaty of mutual guarantee)"),
        // ---- Peace treaties of 1919-1923 ----
        (key: "treaty_of_versailles", kind: Peace, parties: ["GER", "GBR", "FRA", "ITA", "JAP", "BEL", "POL", "CZE"], senior: ["GBR", "FRA", "ITA", "JAP", "BEL", "POL", "CZE"], signed: "1919-06-28", in_force: "1920-01-10", source: "WP 'Treaty of Versailles' (parties in the scenario with direct stakes; arms limits, reparations, demilitarised Rhineland)"),
        (key: "us_german_peace", kind: Peace, parties: ["GER", "USA"], senior: ["USA"], signed: "1921-08-25", in_force: "1921-11-11", source: "WP 'U.S.-German Peace Treaty (1921)'"),
        (key: "treaty_of_saint_germain", kind: Peace, parties: ["AUT", "GBR", "FRA", "ITA", "JAP", "CZE", "POL", "ROM", "YUG"], senior: ["GBR", "FRA", "ITA", "JAP", "CZE", "POL", "ROM", "YUG"], signed: "1919-09-10", in_force: "1920-07-16", source: "WP 'Treaty of Saint-Germain-en-Laye (1919)'"),
        (key: "treaty_of_trianon", kind: Peace, parties: ["HUN", "GBR", "FRA", "ITA", "JAP", "CZE", "ROM", "YUG"], senior: ["GBR", "FRA", "ITA", "JAP", "CZE", "ROM", "YUG"], signed: "1920-06-04", in_force: "1921-07-26", source: "WP 'Treaty of Trianon'"),
        (key: "treaty_of_neuilly", kind: Peace, parties: ["BUL", "GBR", "FRA", "ITA", "JAP", "GRE", "ROM", "YUG"], senior: ["GBR", "FRA", "ITA", "JAP", "GRE", "ROM", "YUG"], signed: "1919-11-27", in_force: "1920-08-09", source: "WP 'Treaty of Neuilly-sur-Seine'"),
        (key: "treaty_of_lausanne", kind: Peace, parties: ["TUR", "GBR", "FRA", "ITA", "JAP", "GRE", "ROM", "YUG"], senior: ["GBR", "FRA", "ITA", "JAP", "GRE", "ROM", "YUG"], signed: "1923-07-24", in_force: "1924-08-06", source: "WP 'Treaty of Lausanne' (Straits demilitarised, Ottoman tariff frozen until 1929)"),
