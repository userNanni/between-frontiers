        (tag: "USA", regime: Gold(grams: 1.504632), from: "1900-03-14", source: "Gold Standard Act of 1900 (US$ 20.67 per troy ounce); WP 'Gold Standard Act'"),
        (tag: "CAN", regime: Paper, from: "1914-08-03", until: Some("1926-07-01"), source: "WP 'Canadian dollar': gold convertibility suspended by the Finance Act 1914, restored 1926-07-01"),
        (tag: "NFL", regime: Peg(anchor: "CAN", per_anchor: Some(1.0)), from: "1895-01-01", estimate: true, source: "WP 'Newfoundland dollar' (at par with the Canadian dollar; Canadian notes circulated after the 1894 bank crash). Date: estimate"),
        (tag: "MEX", regime: Gold(grams: 0.75), from: "1917-01-01", estimate: true, source: "WP 'Mexican peso': 1905 gold parity, metallic money again after the paper of the Revolution (date: estimate); Bank of Mexico 1925-09-01"),
        (tag: "GUA", regime: Paper, from: "1897-01-01", until: Some("1925-05-07"), estimate: true, source: "WP 'Guatemalan peso': inconvertible paper peso (dates: estimate) until the quetzal"),
        (tag: "GUA", regime: GoldExchange(grams: Some(1.504632)), from: "1925-05-07", estimate: true, source: "WP 'Guatemalan quetzal' (at par with the US dollar; day: estimate)"),
        (tag: "HON", regime: Silver(grams: None), from: "1879-01-01", estimate: true, source: "WP 'Honduran peso' (silver peso until the lempira of 1931; dollars circulated on the north coast). Start date: estimate"),
        (tag: "SAL", regime: Gold(grams: 0.752316), from: "1920-01-01", estimate: true, source: "WP 'Salvadoran colón' (half a US dollar in gold under the 1919 monetary law; date: estimate)"),
        (tag: "NIC", regime: Peg(anchor: "USA", per_anchor: Some(1.0)), from: "1912-03-20", source: "WP 'Nicaraguan córdoba' (at par with the dollar, reserve in New York)"),
        (tag: "CRI", regime: Peg(anchor: "USA", per_anchor: Some(4.0)), from: "1922-10-24", estimate: true, source: "WP 'Costa Rican colón' (conversion office at about 4 colones per dollar from 1922; rate and day: estimate)"),
        (tag: "PAN", regime: Foreign(issuer: "USA"), from: "1904-06-28", source: "WP 'Panamanian balboa' (monetary agreement of 1904: the US dollar is legal tender, the balboa only a unit of account)"),
        (tag: "CUB", regime: Foreign(issuer: "USA"), from: "1914-10-29", estimate: true, source: "WP 'Cuban peso': US dollar legal tender and dominant, Cuban coins at par, no Cuban notes until 1934 (date: estimate)"),
        (tag: "HAI", regime: Peg(anchor: "USA", per_anchor: Some(5.0)), from: "1919-01-01", estimate: true, source: "WP 'Haitian gourde' (5 gourdes per dollar under the US-run National Bank; day: estimate)"),
        (tag: "DOM", regime: Foreign(issuer: "USA"), from: "1905-01-01", estimate: true, source: "WP 'Dominican peso' (US dollar the currency from 1905 to 1947; day: estimate)"),
        (tag: "COL", regime: GoldExchange(grams: None), from: "1923-07-23", estimate: true, source: "WP 'Colombian peso', 'Banco de la República' (gold standard of the Kemmerer mission, peso near the dollar; day: estimate)"),
        (tag: "VEN", regime: Gold(grams: 0.290323), from: "1918-06-24", estimate: true, source: "WP 'Venezuelan bolívar' (gold bolívar at the Latin Union parity under the 1918 law; day: estimate)"),
        (tag: "ECU", regime: Paper, from: "1914-08-30", until: Some("1927-08-10"), estimate: true, source: "WP 'Ecuadorian sucre': inconvertible from the 1914 moratorium law until the Central Bank of 1927 (days: estimate)"),
        (tag: "PER", regime: Paper, from: "1914-08-01", estimate: true, source: "WP 'Peruvian pound': inconvertible from 1914 (day: estimate); sol de oro in 1931"),
        (tag: "BOL", regime: Paper, from: "1914-08-01", until: Some("1928-07-20"), estimate: true, source: "WP 'Bolivian boliviano': gold standard of 1908 suspended in 1914, Central Bank of 1928 (days: estimate)"),
        (tag: "CHL", regime: Paper, from: "1898-07-31", until: Some("1926-01-11"), estimate: true, source: "WP 'Chilean peso': inconvertible since 1898 until the Central Bank and gold standard of the Kemmerer mission (days: estimate)"),
        (tag: "ARG", regime: Paper, from: "1914-08-02", until: Some("1927-08-25"), source: "WP 'Argentine peso moneda nacional': Conversion Office closed in 1914, reopened 1927-08-25 (0.44 gold peso per paper peso)"),
        (tag: "URY", regime: Paper, from: "1914-08-07", estimate: true, source: "WP 'Uruguayan peso': gold parity kept in law, convertibility suspended from 1914 (day: estimate)"),
        (tag: "PRY", regime: Paper, from: "1871-01-01", estimate: true, source: "WP 'Paraguayan peso' (inconvertible paper; date: estimate)"),
        (tag: "BRA", regime: Paper, from: "1914-12-01", until: Some("1926-12-18"), estimate: true, source: "WP 'Brazilian real (old)': Conversion Office closed in 1914 (day: estimate), Washington Luís reform 1926-12-18 (200 mg of gold per mil-réis)"),
        // ---- Asia and the Middle East ----
        (tag: "CHN", regime: Silver(grams: Some(23.76)), from: "1914-02-07", source: "WP 'Yuan Shikai dollar' (national currency regulations of 1914: 26.6971 g of silver 0.890); silver until 1935"),
        (tag: "JAP", regime: Paper, from: "1917-09-12", until: Some("1930-01-11"), source: "WP 'Japanese yen': gold export embargo from 1917-09-12, lifted 1930-01-11 at the old parity (0.75 g)"),
        (tag: "MGL", regime: Silver(grams: None), from: "1921-07-11", estimate: true, source: "WP 'Mongolian tögrög': Chinese silver dollars and Russian coins until the tögrög of 1925-12-09, itself silver (start: estimate)"),
        (tag: "TUV", regime: Foreign(issuer: "SOV"), from: "1921-08-14", estimate: true, source: "WP 'Tuvan akşa': Russian and Mongolian money until 1934 (issuer and date: estimate)"),
        (tag: "TIB", regime: Silver(grams: None), from: "1913-02-13", estimate: true, source: "WP 'Tibetan tangka', 'Tibetan srang' (silver coinage; date: estimate)"),
        (tag: "SIA", regime: GoldExchange(grams: None), from: "1908-11-11", estimate: true, source: "WP 'Thai baht' (gold-exchange standard of 1908, reserves in sterling; day: estimate)"),
        (tag: "AFG", regime: Silver(grams: None), from: "1891-01-01", estimate: true, source: "WP 'Afghan rupee', 'Afghan afghani' (silver; the afghani of 1925 kept silver). Date: estimate"),
        (tag: "PRS", regime: Silver(grams: None), from: "1825-01-01", until: Some("1930-03-13"), estimate: true, source: "WP 'Iranian qiran' (silver standard until the 1930 monetary law; dates: estimate)"),
        (tag: "NEP", regime: Silver(grams: None), from: "1900-01-01", estimate: true, source: "WP 'Nepalese mohar' (silver; Indian rupees also circulated). Date: estimate"),
        (tag: "BHU", regime: Foreign(issuer: "RAJ"), from: "1910-01-08", estimate: true, source: "WP 'Bhutanese ngultrum' (Indian rupee in use alongside a few local coins). Date: estimate"),
        (tag: "RAJ", regime: Peg(anchor: "GBR", per_anchor: Some(13.33)), from: "1920-09-01", estimate: true, source: "WP 'Indian rupee': managed near 1s 6d sterling after the failed 2s parity of 1920; fixed by the Currency Act 1927 (rate and date: estimate)"),
        (tag: "IRQ", regime: Foreign(issuer: "RAJ"), from: "1917-03-11", until: Some("1932-04-01"), estimate: true, source: "WP 'Iraqi dinar' (Indian rupee until the dinar of 1932; dates: estimate)"),
        (tag: "TRJ", regime: Foreign(issuer: "EGY"), from: "1921-04-11", until: Some("1927-11-01"), estimate: true, source: "WP 'Palestine pound' (Egyptian pound until the Palestine pound of 1927-11-01; start: estimate)"),
        (tag: "HEJ", regime: Specie, from: "1916-06-10", estimate: true, source: "WP 'Hejaz' / 'Saudi riyal' (Ottoman gold, sovereigns, rupees and Maria Theresa thalers by weight; date: estimate)"),
        (tag: "NEJ", regime: Specie, from: "1902-01-15", estimate: true, source: "WP 'Saudi riyal' (Maria Theresa thalers and rupees; date: estimate)"),
        (tag: "YEM", regime: Specie, from: "1918-10-30", estimate: true, source: "WP 'North Yemeni rial' (Maria Theresa thaler until 1963; date: estimate)"),
        (tag: "OMA", regime: Foreign(issuer: "RAJ"), from: "1891-03-20", estimate: true, source: "WP 'Omani rial' (Indian rupee and Maria Theresa thalers until 1970). Date: estimate"),
        (tag: "KUW", regime: Foreign(issuer: "RAJ"), from: "1899-01-23", estimate: true, source: "WP 'Kuwaiti dinar' (Indian rupee until 1961). Date: estimate"),
        // ---- Africa and Oceania ----
        (tag: "EGY", regime: Peg(anchor: "GBR", per_anchor: Some(0.975)), from: "1916-08-02", estimate: true, source: "WP 'Egyptian pound' (sterling exchange standard at £E 0.975 per pound from the war; day: estimate)"),
        (tag: "ETH", regime: Silver(grams: None), from: "1894-01-01", estimate: true, source: "WP 'Ethiopian birr' (Maria Theresa and Menelik thalers, notes of the Bank of Abyssinia). Date: estimate"),
        (tag: "LBR", regime: Foreign(issuer: "GBR"), from: "1907-01-01", estimate: true, source: "WP 'Liberian dollar' (British West African money, at par with sterling, until 1943). Issuer and date: estimate"),
        (tag: "SAF", regime: Peg(anchor: "GBR", per_anchor: Some(1.0)), from: "1921-04-01", estimate: true, source: "WP 'South African pound' (at par with sterling, Reserve Bank 1921; back on gold with Britain in 1925 and off only in Dec. 1932). Date: estimate"),
        (tag: "AUS", regime: Peg(anchor: "GBR", per_anchor: Some(1.0)), from: "1910-12-01", estimate: true, source: "WP 'Australian pound' (at par with sterling until 1929-31). Date: estimate"),
        (tag: "NZL", regime: Peg(anchor: "GBR", per_anchor: Some(1.0)), from: "1914-08-05", estimate: true, source: "WP 'New Zealand pound' (sterling exchange at par until 1930). Date: estimate"),
    ],
    // Import duties over total imports, 1925. Only the United States is cited; the rest are
    // estimates from the tariff regime of each country (see docs/diplomacy.pt-BR.md, "Tarifas").
    tariffs: [
        // ---- Europe ----
        (tag: "GBR", rate: 0.09, estimate: true, source: "revenue duties (tea, sugar, tobacco, drink) plus McKenna and safeguarding duties; free trade in manufactures"),
        (tag: "IRL", rate: 0.12, estimate: true, source: "British revenue duties inherited plus the first protective duties of 1924"),
        (tag: "FRA", rate: 0.07, estimate: true, source: "Méline tariff with specific duties eroded by inflation; coefficients raised from 1926"),
        (tag: "BEL", rate: 0.04, estimate: true, source: "low tariff of an open economy (BLEU)"),
        (tag: "NLD", rate: 0.04, estimate: true, source: "low revenue tariff, free-trade policy"),
        (tag: "LUX", rate: 0.04, estimate: true, source: "Belgian tariff inside the BLEU"),
        (tag: "CHE", rate: 0.09, estimate: true, source: "Swiss tariff of 1921, high for a small economy, largely fiscal"),
        (tag: "ESP", rate: 0.16, estimate: true, source: "Cambó tariff of 1922, among the highest in Europe"),
        (tag: "POR", rate: 0.15, estimate: true, source: "fiscal tariff, main state revenue"),
        (tag: "ITA", rate: 0.08, estimate: true, source: "tariff of 1921 with the wheat duty restored in 1925"),
        (tag: "SMR", rate: 0.08, estimate: true, source: "Italian tariff"),
        (tag: "GER", rate: 0.06, estimate: true, source: "Versailles most-favoured-nation clauses until Jan. 1925, new tariff law of Aug. 1925"),
        (tag: "SAA", rate: 0.07, estimate: true, source: "French customs regime"),
        (tag: "DNZ", rate: 0.14, estimate: true, source: "Polish customs territory"),
        (tag: "AUT", rate: 0.08, estimate: true, source: "tariff of 1924"),
        (tag: "HUN", rate: 0.12, estimate: true, source: "protective tariff of 1924"),
        (tag: "CZE", rate: 0.10, estimate: true, source: "Austro-Hungarian tariff of 1906 with coefficients"),
        (tag: "POL", rate: 0.14, estimate: true, source: "protective tariff of 1924 and import bans of 1925"),
        (tag: "LTU", rate: 0.10, estimate: true, source: "fiscal tariff"),
        (tag: "LAT", rate: 0.12, estimate: true, source: "fiscal and protective tariff"),
        (tag: "EST", rate: 0.15, estimate: true, source: "high tariff of 1924"),
        (tag: "FIN", rate: 0.15, estimate: true, source: "fiscal tariff, customs a third of state revenue"),
        (tag: "SWE", rate: 0.08, estimate: true, source: "moderate tariff, mostly specific"),
        (tag: "NOR", rate: 0.10, estimate: true, source: "fiscal tariff raised in the 1920s"),
        (tag: "DEN", rate: 0.05, estimate: true, source: "low tariff, agrarian exporter"),
        (tag: "ISL", rate: 0.15, estimate: true, source: "fiscal tariff, main state revenue"),
        (tag: "SOV", rate: 0.15, estimate: true, source: "state monopoly of foreign trade; the tariff is a minor instrument (rate: order of magnitude)"),
        (tag: "ROM", rate: 0.12, estimate: true, source: "protective tariff of 1924"),
        (tag: "YUG", rate: 0.15, estimate: true, source: "tariff of 1925, fiscal and protective"),
        (tag: "BUL", rate: 0.15, estimate: true, source: "protective tariff"),
        (tag: "ALB", rate: 0.15, estimate: true, source: "fiscal tariff, main state revenue"),
        (tag: "GRE", rate: 0.20, estimate: true, source: "fiscal tariff, main state revenue"),
        (tag: "TUR", rate: 0.10, estimate: true, source: "Ottoman tariff frozen by Lausanne until 1929"),
        (tag: "LIE", rate: 0.09, estimate: true, source: "Swiss customs territory"),
        (tag: "MCO", rate: 0.07, estimate: true, source: "French customs union"),
        (tag: "AND", rate: 0.02, estimate: true, source: "almost no duties"),
        // ---- Americas ----
        (tag: "USA", rate: 0.14, estimate: false, source: "U.S. Tariff Commission, duties over all imports under the Fordney-McCumber tariff, about 14 % in 1923-29 (38.5 % on dutiable goods); WP 'Fordney-McCumber Tariff'"),
        (tag: "CAN", rate: 0.16, estimate: true, source: "National Policy tariff with British preference"),
        (tag: "NFL", rate: 0.25, estimate: true, source: "fiscal tariff, customs most of state revenue"),
        (tag: "MEX", rate: 0.20, estimate: true, source: "fiscal and protective tariff"),
        (tag: "GUA", rate: 0.25, estimate: true, source: "fiscal tariff, customs most of state revenue"),
        (tag: "HON", rate: 0.25, estimate: true, source: "fiscal tariff, customs most of state revenue"),
        (tag: "SAL", rate: 0.25, estimate: true, source: "fiscal tariff, customs most of state revenue"),
        (tag: "NIC", rate: 0.25, estimate: true, source: "fiscal tariff under the US customs collectorship"),
        (tag: "CRI", rate: 0.25, estimate: true, source: "fiscal tariff, customs most of state revenue"),
        (tag: "PAN", rate: 0.12, estimate: true, source: "low tariff of a transit economy"),
        (tag: "CUB", rate: 0.20, estimate: true, source: "tariff with 20 % reciprocity preference for the United States"),
        (tag: "HAI", rate: 0.20, estimate: true, source: "fiscal tariff under the US customs receivership"),
        (tag: "DOM", rate: 0.18, estimate: true, source: "fiscal tariff under the US customs receivership"),
        (tag: "COL", rate: 0.25, estimate: true, source: "fiscal and protective tariff"),
        (tag: "VEN", rate: 0.30, estimate: true, source: "fiscal tariff, customs the main revenue before oil"),
        (tag: "ECU", rate: 0.25, estimate: true, source: "fiscal tariff"),
        (tag: "PER", rate: 0.18, estimate: true, source: "fiscal tariff"),
        (tag: "BOL", rate: 0.20, estimate: true, source: "fiscal tariff"),
        (tag: "CHL", rate: 0.18, estimate: true, source: "protective tariff of 1921; the state lived on nitrate export duties"),
        (tag: "ARG", rate: 0.15, estimate: true, source: "fiscal tariff with valuations revised in 1923"),
        (tag: "URY", rate: 0.20, estimate: true, source: "fiscal and protective tariff"),
        (tag: "PRY", rate: 0.20, estimate: true, source: "fiscal tariff"),
        (tag: "BRA", rate: 0.26, estimate: true, source: "fiscal and protective tariff, among the highest in the world"),
        // ---- Asia and the Middle East ----
        (tag: "CHN", rate: 0.04, estimate: true, source: "treaty tariff of 5 % nominal, lower in effect; tariff autonomy only in 1929"),
        (tag: "JAP", rate: 0.07, estimate: true, source: "tariff of 1911 with specific duties; revision of 1926"),
        (tag: "MGL", rate: 0.05, estimate: true, source: "low duties; trade run by Soviet and Mongolian co-operatives"),
        (tag: "TUV", rate: 0.05, estimate: true, source: "low duties"),
        (tag: "TIB", rate: 0.03, estimate: true, source: "almost no duties"),
