        (key: "dawes_plan", kind: Reparations, parties: ["GER", "FRA", "GBR", "ITA", "BEL", "JAP"], senior: ["FRA", "GBR", "ITA", "BEL", "JAP"], signed: "1924-08-16", in_force: "1924-09-01", source: "WP 'Dawes Plan' (London agreement; main creditors in the scenario)"),
        (key: "baldwin_mellon_settlement", kind: DebtSettlement, parties: ["GBR", "USA"], senior: ["USA"], signed: "1923-06-19", in_force: "1923-06-19", source: "WP 'World War I reparations' / British war debt to the United States (funding agreement of 1923)"),
        (key: "rhineland_occupation", kind: Occupation, parties: ["GER", "FRA", "BEL", "GBR"], senior: ["FRA", "BEL", "GBR"], signed: "1919-06-28", in_force: "1920-01-10", until: Some("1930-06-30"), source: "Treaty of Versailles art. 428 and the Rhineland Agreement; WP 'Occupation of the Rhineland'"),
        (key: "ruhr_occupation", kind: Occupation, parties: ["GER", "FRA", "BEL"], senior: ["FRA", "BEL"], signed: "1923-01-11", in_force: "1923-01-11", until: Some("1925-08-25"), source: "WP 'Occupation of the Ruhr' (not a treaty: dates are the entry and the last withdrawal)"),
        (key: "nicaragua_occupation", kind: Occupation, parties: ["NIC", "USA"], senior: ["USA"], signed: "1912-08-04", in_force: "1912-08-04", until: Some("1925-08-03"), source: "WP 'United States occupation of Nicaragua' (first period; marines return in 1926)"),
        // ---- Protection without subjection ----
        (key: "cuban_american_treaty_1903", kind: Protection, parties: ["CUB", "USA"], senior: ["USA"], signed: "1903-05-22", in_force: "1904-07-01", until: Some("1934-06-09"), source: "WP 'Platt Amendment' (Cuban-American Treaty of Relations, replaced in 1934)"),
        (key: "hay_bunau_varilla_treaty", kind: Protection, parties: ["PAN", "USA"], senior: ["USA"], signed: "1903-11-18", in_force: "1904-02-26", until: Some("1939-07-27"), source: "WP 'Hay-Bunau-Varilla Treaty' (Canal Zone, US guarantee and right to intervene; replaced by the Hull-Alfaro Treaty)"),
        (key: "haitian_american_convention", kind: Protection, parties: ["HAI", "USA"], senior: ["USA"], signed: "1915-09-16", in_force: "1916-05-03", source: "WP 'United States occupation of Haiti' (customs and finances under US officials; occupation until 1934-08-15)"),
        (key: "dominican_american_convention", kind: Protection, parties: ["DOM", "USA"], senior: ["USA"], signed: "1907-02-08", in_force: "1907-07-08", source: "WP 'Dominican-American Convention of 1907' (US customs receivership). Entry into force: estimate"),
        (key: "egypt_declaration_1922", kind: Protection, parties: ["EGY", "GBR"], senior: ["GBR"], signed: "1922-02-28", in_force: "1922-02-28", until: Some("1936-12-22"), source: "WP 'Unilateral Declaration of Egyptian Independence' (four reserved points: British troops, communications, Sudan, foreigners); replaced by the treaty of 1936"),
        (key: "treaty_of_darin", kind: Protection, parties: ["NEJ", "GBR"], senior: ["GBR"], signed: "1915-12-26", in_force: "1915-12-26", until: Some("1927-05-20"), source: "WP 'Treaty of Darin'; replaced by the Treaty of Jeddah (1927)"),
        (key: "franco_monegasque_treaty_1918", kind: Protection, parties: ["MCO", "FRA"], senior: ["FRA"], signed: "1918-07-17", in_force: "1919-06-28", source: "WP 'Franco-Monegasque Treaty' (1918); recognised by Versailles art. 436. Entry into force: estimate"),
        (key: "pareage_of_andorra", kind: Protection, parties: ["AND", "FRA"], senior: ["FRA"], signed: "1278-09-08", in_force: "1278-09-08", source: "WP 'Paréage of Andorra (1278)'; the French head of state is co-prince, the other co-prince is the Bishop of Urgell (no state party)"),
        // ---- Friendship and recognition elsewhere ----
        (key: "treaty_of_kabul_1921", kind: Friendship, parties: ["AFG", "GBR"], signed: "1921-11-22", in_force: "1922-02-06", source: "WP 'Anglo-Afghan Treaty of 1921'. Entry into force: estimate"),
        (key: "nepal_britain_treaty_1923", kind: Friendship, parties: ["NEP", "GBR"], signed: "1923-12-21", in_force: "1923-12-21", source: "WP 'Nepal-Britain Treaty of 1923' (recognition of independence). In force taken at signature"),
        (key: "simla_convention", kind: Friendship, parties: ["TIB", "GBR"], signed: "1914-07-03", in_force: "1914-07-03", source: "WP 'Simla Convention' (signed by Britain and Tibet, not by China; McMahon Line)"),
        (key: "treaty_of_moscow_1921", kind: Friendship, parties: ["SOV", "TUR"], signed: "1921-03-16", in_force: "1921-03-16", source: "WP 'Treaty of Moscow (1921)'. In force taken at signature"),
        (key: "soviet_turkish_neutrality_1925", kind: Friendship, parties: ["SOV", "TUR"], signed: "1925-12-17", in_force: "1925-12-17", source: "WP 'Soviet-Turkish Treaty of Friendship and Neutrality' (1925). In force taken at signature"),
        (key: "russo_persian_treaty_1921", kind: Friendship, parties: ["SOV", "PRS"], signed: "1921-02-26", in_force: "1921-02-26", source: "WP 'Russo-Persian Treaty of Friendship (1921)' (art. 6: Soviet right to intervene). In force taken at signature"),
        (key: "soviet_afghan_treaty_1921", kind: Friendship, parties: ["SOV", "AFG"], signed: "1921-02-28", in_force: "1921-02-28", source: "WP 'Afghan-Soviet Treaty of 1921'. In force taken at signature"),
        (key: "soviet_japanese_convention", kind: Friendship, parties: ["SOV", "JAP"], signed: "1925-01-20", in_force: "1925-02-26", source: "WP 'Soviet-Japanese Basic Convention' (recognition; Japan leaves northern Sakhalin)"),
        (key: "sino_soviet_agreement_1924", kind: Friendship, parties: ["CHN", "SOV"], signed: "1924-05-31", in_force: "1924-05-31", source: "WP 'Sino-Soviet Agreement (1924)' (recognition, joint Chinese Eastern Railway)"),
        (key: "central_american_treaty_1923", kind: Friendship, parties: ["GUA", "SAL", "HON", "NIC", "CRI"], signed: "1923-02-07", in_force: "1923-02-07", source: "WP 'Central American Treaty of Peace and Amity (1923)' (non-recognition of governments born of coups). In force taken at signature"),
        // ---- Instruments behind the subject relations of countries.ron ----
        (key: "anglo_irish_treaty", kind: Subjection, parties: ["IRL", "GBR"], senior: ["GBR"], signed: "1921-12-06", in_force: "1922-03-31", source: "WP 'Anglo-Irish Treaty'; Irish Free State (Agreement) Act 1922"),
        (key: "anglo_iraqi_treaty_1922", kind: Subjection, parties: ["IRQ", "GBR"], senior: ["GBR"], signed: "1922-10-10", in_force: "1924-12-19", until: Some("1932-10-03"), source: "WP 'Anglo-Iraqi Treaty of 1922' (mandate by treaty; ends with independence and League entry)"),
        (key: "transjordan_memorandum", kind: Subjection, parties: ["TRJ", "GBR"], senior: ["GBR"], signed: "1922-09-16", in_force: "1923-09-29", source: "WP 'Transjordan memorandum' and 'Mandate for Palestine' (in force 1923-09-29)"),
        (key: "treaty_of_punakha", kind: Subjection, parties: ["BHU", "GBR"], senior: ["GBR"], signed: "1910-01-08", in_force: "1910-01-08", source: "WP 'Treaty of Punakha' (Britain guides foreign relations). In force taken at signature"),
        (key: "anglo_kuwaiti_agreement", kind: Subjection, parties: ["KUW", "GBR"], senior: ["GBR"], signed: "1899-01-23", in_force: "1899-01-23", source: "WP 'Anglo-Kuwaiti Agreement of 1899'"),
        (key: "muscat_exclusive_agreement", kind: Subjection, parties: ["OMA", "GBR"], senior: ["GBR"], signed: "1891-03-20", in_force: "1891-03-20", source: "WP 'Muscat and Oman' (exclusive agreement with Britain, 1891)"),
        (key: "soviet_mongolian_agreement", kind: Subjection, parties: ["MGL", "SOV"], senior: ["SOV"], signed: "1921-11-05", in_force: "1921-11-05", source: "WP 'Mongolian People's Republic' (Soviet-Mongolian friendship agreement of 1921). In force taken at signature"),
        // ---- Customs unions ----
        (key: "belgium_luxembourg_union", kind: CustomsUnion, parties: ["LUX", "BEL"], senior: ["BEL"], signed: "1921-07-25", in_force: "1922-05-01", source: "WP 'Belgium-Luxembourg Economic Union'"),
        (key: "swiss_liechtenstein_customs", kind: CustomsUnion, parties: ["LIE", "CHE"], senior: ["CHE"], signed: "1923-03-29", in_force: "1924-01-01", source: "WP 'Liechtenstein-Switzerland relations' (customs treaty of 1923)"),
        (key: "franco_monegasque_customs", kind: CustomsUnion, parties: ["MCO", "FRA"], senior: ["FRA"], signed: "1865-05-09", in_force: "1865-05-09", source: "WP 'France-Monaco relations' (customs union convention of 1865). In force taken at signature"),
        (key: "saar_french_customs", kind: CustomsUnion, parties: ["SAA", "FRA"], senior: ["FRA"], signed: "1919-06-28", in_force: "1920-01-10", until: Some("1935-03-01"), source: "Treaty of Versailles, annex to arts. 45-50, para. 31 (Saar inside the French customs regime); WP 'Territory of the Saar Basin'"),
        (key: "danzig_polish_customs", kind: CustomsUnion, parties: ["DNZ", "POL"], senior: ["POL"], signed: "1920-11-09", in_force: "1922-01-01", source: "Convention of Paris (1920-11-09); WP 'Free City of Danzig' (inside the Polish customs territory from 1922)"),
