        // ---- Alliances in Central and Eastern Europe ----
        (key: "cze_yug_alliance", kind: DefensiveAlliance, parties: ["CZE", "YUG"], signed: "1920-08-14", in_force: "1920-08-14", bloc: Some("little_entente"), source: "WP 'Little Entente'; LNTS. In force taken at signature"),
