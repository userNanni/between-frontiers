    monetary: [
        // ---- Europe ----
        (tag: "GBR", regime: Paper, from: "1919-03-31", until: Some("1925-04-28"), source: "WP 'Gold standard', 'Gold Standard Act 1925': gold export embargo from 1919, legal under the 1920 Act"),
        (tag: "GBR", regime: Gold(grams: 7.322382), from: "1925-04-28", until: Some("1931-09-21"), source: "Gold Standard Act 1925 (bullion standard at the pre-war parity, US$ 4.8665); WP 'Gold standard'"),
        (tag: "IRL", regime: Foreign(issuer: "GBR"), from: "1922-12-06", until: Some("1928-09-10"), estimate: true, source: "WP 'Saorstát pound': sterling until the Irish notes of 1928 (Currency Act 1927). End date: estimate"),
        (tag: "FRA", regime: Paper, from: "1914-08-05", until: Some("1928-06-25"), source: "WP 'French franc': inconvertible from 1914; de facto stabilisation Dec. 1926, Poincaré franc (65.5 mg of gold 900) on 1928-06-25"),
        (tag: "BEL", regime: Paper, from: "1914-08-02", until: Some("1926-10-25"), estimate: true, source: "WP 'Belgian franc', 'Belga': inconvertible from 1914 (start date: estimate) until the belga stabilisation of 1926-10-25"),
        (tag: "NLD", regime: Paper, from: "1914-08-03", until: Some("1925-04-28"), estimate: true, source: "WP 'Dutch guilder': gold embargo from 1914 (start date: estimate), lifted with Britain's return"),
        (tag: "NLD", regime: Gold(grams: 0.6048), from: "1925-04-28", until: Some("1936-09-26"), source: "WP 'Dutch guilder' (pre-war parity, 1653.44 guilders per kg of fine gold)"),
        (tag: "LUX", regime: Peg(anchor: "BEL", per_anchor: Some(1.0)), from: "1922-05-01", source: "WP 'Luxembourg franc' (at par with the Belgian franc inside the BLEU)"),
        (tag: "CHE", regime: Gold(grams: 0.290323), from: "1924-12-31", estimate: true, source: "WP 'Swiss franc': back at the Latin Union parity de facto by 1924-25 (day: estimate), legal convertibility 1929"),
        (tag: "ESP", regime: Paper, from: "1883-08-01", estimate: true, source: "WP 'Spanish peseta': gold convertibility suspended in 1883 (day: estimate), never restored"),
        (tag: "POR", regime: Paper, from: "1891-05-01", estimate: true, source: "WP 'Portuguese escudo': convertibility suspended in 1891 (day: estimate), gold-exchange only in 1931"),
        (tag: "ITA", regime: Paper, from: "1894-02-21", until: Some("1927-12-21"), estimate: true, source: "WP 'Italian lira': forced currency from 1894 (day: estimate) until the 'quota 90' stabilisation of 1927-12-21"),
        (tag: "SMR", regime: Foreign(issuer: "ITA"), from: "1862-03-22", estimate: true, source: "WP 'Sammarinese lira' (Italian lira under the 1862 convention). Start date: estimate"),
        (tag: "GER", regime: GoldExchange(grams: Some(0.358423)), from: "1924-08-30", source: "Bank Act of 1924-08-30, Reichsmark of 2790 RM per kg of fine gold; WP 'German reichsmark'"),
        (tag: "SAA", regime: Foreign(issuer: "FRA"), from: "1923-06-01", estimate: true, source: "WP 'Territory of the Saar Basin': French franc sole legal tender from 1923 (day: estimate)"),
        (tag: "DNZ", regime: Peg(anchor: "GBR", per_anchor: Some(25.0)), from: "1923-10-20", source: "WP 'Danzig gulden' (25 gulden to the pound sterling, Bank of Danzig)"),
        (tag: "AUT", regime: GoldExchange(grams: None), from: "1923-01-02", until: Some("1925-03-01"), estimate: true, source: "WP 'Austrian krone': crown stabilised under the League loan of 1922, Austrian National Bank from 1923 (day: estimate)"),
        (tag: "AUT", regime: GoldExchange(grams: Some(0.21173)), from: "1925-03-01", source: "WP 'Austrian schilling' (law of 1924-12-20, in circulation 1925-03-01; 1 kg fine gold = 4723 S)"),
        (tag: "HUN", regime: Peg(anchor: "GBR", per_anchor: Some(346500.0)), from: "1924-06-24", estimate: true, source: "WP 'Hungarian korona': stabilised against sterling by the National Bank of Hungary in 1924 (rate and day: estimate); pengő in 1927"),
        (tag: "CZE", regime: Paper, from: "1919-02-25", until: Some("1929-11-07"), estimate: true, source: "WP 'Czechoslovak koruna': inconvertible, held near 33.8 to the dollar from 1923; gold parity by law in 1929 (days: estimate)"),
        (tag: "POL", regime: GoldExchange(grams: Some(0.290323)), from: "1924-04-28", until: Some("1925-08-01"), estimate: true, source: "WP 'Polish złoty': Grabski reform, złoty at the gold franc; parity given up in the summer of 1925 (end: estimate)"),
        (tag: "POL", regime: Paper, from: "1925-08-01", until: Some("1927-10-13"), estimate: true, source: "WP 'Polish złoty': floating until the stabilisation of 1927-10-13 (start: estimate)"),
        (tag: "LTU", regime: GoldExchange(grams: Some(0.150463)), from: "1922-10-02", source: "WP 'Lithuanian litas' (a tenth of a dollar in gold)"),
        (tag: "LAT", regime: GoldExchange(grams: Some(0.290323)), from: "1922-08-03", estimate: true, source: "WP 'Latvian lats' (the gold franc; introduced in 1922, day: estimate)"),
        (tag: "EST", regime: Paper, from: "1919-01-01", until: Some("1928-01-01"), estimate: true, source: "WP 'Estonian mark': inconvertible until the kroon of 1928 (start: estimate)"),
        (tag: "FIN", regime: Paper, from: "1914-08-01", until: Some("1926-01-01"), estimate: true, source: "WP 'Finnish markka': inconvertible from 1914 (day: estimate), held stable from 1922, gold standard by law 1926-01-01"),
        (tag: "SWE", regime: Gold(grams: 0.403226), from: "1924-04-01", until: Some("1931-09-27"), source: "WP 'Swedish krona' (first to return to the pre-war parity, 2480 kronor per kg)"),
        (tag: "NOR", regime: Paper, from: "1914-08-05", until: Some("1928-05-01"), estimate: true, source: "WP 'Norwegian krone': inconvertible from 1914 (day: estimate), back at par 1928-05-01"),
        (tag: "DEN", regime: Paper, from: "1914-08-02", until: Some("1927-01-01"), estimate: true, source: "WP 'Danish krone': inconvertible from 1914 (day: estimate), back at par 1927-01-01"),
        (tag: "ISL", regime: Paper, from: "1914-08-04", estimate: true, source: "WP 'Icelandic króna': inconvertible since 1914 (day: estimate); held against sterling from 1925"),
        (tag: "SOV", regime: GoldExchange(grams: Some(7.74234)), from: "1924-02-14", estimate: true, source: "WP 'Soviet chervonets' (10 pre-war gold roubles; single currency after the 1924 reform, day: estimate; traded freely only at home)"),
        (tag: "ROM", regime: Paper, from: "1916-08-27", until: Some("1929-02-07"), estimate: true, source: "WP 'Romanian leu': inconvertible from the war (start: estimate) until the stabilisation of 1929-02-07"),
        (tag: "YUG", regime: Paper, from: "1918-12-01", estimate: true, source: "WP 'Yugoslav dinar': inconvertible, held stable from 1925; legal stabilisation 1931 (start: estimate)"),
        (tag: "BUL", regime: Paper, from: "1912-10-08", estimate: true, source: "WP 'Bulgarian lev': inconvertible since the Balkan Wars (start: estimate); stabilised by law 1928"),
        (tag: "ALB", regime: Specie, from: "1912-11-28", until: Some("1926-01-01"), estimate: true, source: "WP 'Albanian lek': no national money until the National Bank's franga (1926; day: estimate); foreign gold and silver coins circulated"),
        (tag: "GRE", regime: Paper, from: "1914-08-01", until: Some("1928-05-14"), estimate: true, source: "WP 'Greek drachma': inconvertible (start: estimate) until the stabilisation and Bank of Greece of 1928"),
        (tag: "TUR", regime: Paper, from: "1915-04-01", estimate: true, source: "WP 'Turkish lira': paper money since the war loans of 1915 (day: estimate)"),
        (tag: "LIE", regime: Foreign(issuer: "CHE"), from: "1924-05-26", estimate: true, source: "WP 'Liechtenstein' (Swiss franc adopted by law in 1924; day: estimate)"),
        (tag: "MCO", regime: Foreign(issuer: "FRA"), from: "1865-05-09", estimate: true, source: "WP 'Monegasque franc' (French franc in circulation at par). Start date: estimate"),
        (tag: "AND", regime: Foreign(issuer: "FRA"), from: "1900-01-01", estimate: true, source: "WP 'Andorra' (no national money; French franc and Spanish peseta both circulated). Issuer and date: estimate"),
