// Between Frontiers: sea zones, straits and canals. Read by `cargo run -p bf-mapgen --release --
// seas`, which writes assets/map/seas.ron and seas.png. Method: docs/map-pipeline.pt-BR.md, "Zonas
// marítimas". Licence: CC BY-SA 4.0.
//
// Zones: each is a list of Natural Earth 5.1 1:10m marine polygons (ne_10m_geography_marine_polys,
// public domain) by name, optionally clipped to a lon/lat box. A pixel goes to the first zone in
// this file that claims it, so seas come before the oceans around them; water no listed polygon
// covers (gulfs, bays, sounds) joins the nearest zone through water.
//
// Ice: the norm of the 20th century, for the zone's ports. Free unless said; every other class
// cites its source. Seasonal: closed in the northern winter without icebreakers. Permanent: closed
// in both seasons of the game without icebreakers, which includes the seas of the Northern Sea
// Route, open only two to four months a year. WP = Wikipedia (en), CC BY-SA 4.0, facts only.
//
// Straits and canals: declared when the owner of a shore can close the passage AND closing it
// changes a route or traps a fleet. Wide passages no shore can close (Greenland–Iceland–UK, the
// Mozambique Channel, the Strait of Sicily, the Taiwan Strait, the Florida Straits, the Yucatán
// Channel) stay ordinary contacts between zones. `shores` are state keys of assets/map/
// provinces.ron; who controls a passage is the owner of those states at the time, unless a
// country holds it by treaty or occupation (`holders`, whose dates are history, not a script).
#![enable(implicit_some)]
(
    zones: [
        // ---------------------------------- Arctic ----------------------------------
        (key: "white_sea", name: "White Sea", parts: [(feature: "White Sea")],
            ice: Seasonal, ice_source: "WP 'White Sea' (Climate: frozen Oct/Nov to Apr/May); WP 'Arkhangelsk' (History: five months of ice)"),
        (key: "barents_south", name: "Barents Sea (south)", parts: [(feature: "Barents Sea", lon: (15.0, 41.5), lat: (66.0, 74.0))],
            ice: Free, ice_source: "WP 'Barents Sea' (Geography: the southern half stays ice-free all year, North Atlantic Drift); WP 'Murmansk' (port ice-free all year)"),
        (key: "barents_north", name: "Barents Sea (north and Pechora)", parts: [(feature: "Barents Sea")],
            ice: Seasonal, ice_source: "WP 'Pechora Sea' (ice from November to June); WP 'Barents Sea' (only the southern half ice-free)"),
        (key: "kara_sea", name: "Kara Sea", parts: [(feature: "Kara Sea"), (feature: "Gulf of Ob"), (feature: "Yenisey Gulf")],
            ice: Permanent, ice_source: "WP 'Kara Sea' (icebound all but about two months); WP 'Northern Sea Route' (icebreakers needed most of the year; first one-season transit 1932): open too briefly for a season of the game, so closed without icebreakers"),
        (key: "laptev_east_siberian", name: "Laptev and East Siberian Seas", parts: [(feature: "Laptev Sea"), (feature: "East Siberian Sea")],
            ice: Permanent, ice_source: "WP 'Laptev Sea' (clear only Aug–Sep); WP 'East Siberian Sea' (melts fully only Aug–Sep; shipping hindered even in summer): closed without icebreakers"),
        (key: "chukchi_sea", name: "Chukchi Sea", parts: [(feature: "Chukchi Sea")],
            ice: Permanent, ice_source: "WP 'Chukchi Sea' (navigable only about four months; Vega frozen in 1878–79, Chelyuskin crushed 1933–34): closed without icebreakers"),
        (key: "canadian_arctic", name: "Beaufort Sea and the Northwest Passages", parts: [(feature: "Beaufort Sea"), (feature: "The North Western Passages"), (feature: "Amundsen Gulf"), (feature: "Viscount Melville Sound"), (feature: "M'Clure Strait")],
            ice: Permanent, ice_source: "WP 'Beaufort Sea' (frozen almost all year; only a coastal lane opens Aug–Sep)"),
        (key: "arctic_ocean", name: "Arctic Ocean", parts: [(feature: "Arctic Ocean"), (feature: "Lincoln Sea")],
            ice: Permanent, ice_source: "WP 'Arctic Ocean' (Sea ice); WP 'Arctic sea ice decline' (multi-year ice until the 2000s)"),
        (key: "hudson_bay", name: "Hudson Bay", parts: [(feature: "Hudson Bay"), (feature: "Hudson Strait"), (feature: "Foxe Basin"), (feature: "James Bay")],
            ice: Seasonal, ice_source: "WP 'Hudson Bay' (Climate: ice mid-December to mid-June)"),
        (key: "labrador_baffin", name: "Labrador Sea and Baffin Bay", parts: [(feature: "Labrador Sea"), (feature: "Baffin Bay"), (feature: "Davis Strait")],
            ice: Seasonal, ice_source: "WP 'Labrador Sea' (Oceanography: two-thirds iced in winter); WP 'Baffin Bay' (not navigable most of the year)"),
        (key: "greenland_sea", name: "Greenland Sea", parts: [(feature: "Greenland Sea"), (feature: "Denmark Strait")],
            ice: Seasonal, ice_source: "WP 'Greenland Sea' (Hydrology: ice season October to August along Greenland)"),
        (key: "norwegian_sea", name: "Norwegian Sea", parts: [(feature: "Norwegian Sea")],
            ice: Free, ice_source: "WP 'Norwegian Sea' (ice-free throughout the year)"),
        // ---------------------------------- North Atlantic and Europe ----------------------------------
        (key: "gulf_of_st_lawrence", name: "Gulf of Saint Lawrence", parts: [(feature: "Gulf of Saint Lawrence"), (feature: "Saint Lawrence River")],
            ice: Seasonal, ice_source: "WP 'Gulf of Saint Lawrence' (covered Jan–Feb); WP 'Port of Montreal' (year-round navigation only from 1964)"),
        (key: "north_sea", name: "North Sea", parts: [(feature: "North Sea")], ice: Free),
        (key: "kattegat", name: "Skagerrak and Kattegat", parts: [(feature: "Skagerrak"), (feature: "Kattegat")], ice: Free),
        (key: "baltic_south", name: "Baltic Sea (south)", parts: [(feature: "Baltic Sea", lat: (53.0, 58.5))],
            ice: Free, ice_source: "WP 'Baltic Sea' (Sea ice conditions: the southern Baltic stays free in normal winters)"),
        (key: "gulf_of_bothnia", name: "Gulf of Bothnia", parts: [(feature: "Gulf of Bothnia"), (feature: "Baltic Sea", lat: (58.5, 70.0), lon: (16.0, 22.0))],
            ice: Seasonal, ice_source: "WP 'Gulf of Bothnia' (about five months of ice; icebreakers up to six)"),
        (key: "gulf_of_finland", name: "Gulfs of Finland and Riga", parts: [(feature: "Gulf of Finland"), (feature: "Gulf of Riga"), (feature: "Baltic Sea")],
            ice: Seasonal, ice_source: "WP 'Gulf of Finland' (late November to late April); WP 'Gulf of Riga' (frozen most of the winter); WP 'Saint Petersburg' (Neva frozen Nov/Dec to April)"),
        (key: "english_channel", name: "English Channel", parts: [(feature: "English Channel")], ice: Free),
        // ---------------------------------- Mediterranean and Black Sea ----------------------------------
        (key: "western_mediterranean", name: "Western Mediterranean", parts: [(feature: "Alboran Sea"), (feature: "Balearic Sea"), (feature: "Mediterranean Sea", lon: (-6.0, 9.5))], ice: Free),
        (key: "tyrrhenian_sea", name: "Tyrrhenian and Ligurian Seas", parts: [(feature: "Tyrrhenian Sea"), (feature: "Ligurian Sea")], ice: Free),
        (key: "adriatic_sea", name: "Adriatic Sea", parts: [(feature: "Adriatic Sea")], ice: Free),
        (key: "aegean_sea", name: "Aegean Sea", parts: [(feature: "Aegean Sea"), (feature: "Sea of Crete")], ice: Free),
        (key: "sea_of_marmara", name: "Sea of Marmara", parts: [(feature: "Sea of Marmara")], ice: Free),
        (key: "central_mediterranean", name: "Central Mediterranean and Ionian Sea", parts: [(feature: "Ionian Sea"), (feature: "Gulf of Sidra"), (feature: "Mediterranean Sea", lon: (9.5, 23.5))], ice: Free),
        (key: "eastern_mediterranean", name: "Eastern Mediterranean", parts: [(feature: "Mediterranean Sea")], ice: Free),
        (key: "sea_of_azov", name: "Sea of Azov", parts: [(feature: "Sea of Azov")],
            ice: Seasonal, ice_source: "WP 'Sea of Azov' (Climate: ice possible late December to mid-March; navigation halted before icebreakers)"),
        (key: "black_sea", name: "Black Sea", parts: [(feature: "Black Sea")], ice: Free),
        (key: "caspian_sea", name: "Caspian Sea", parts: [(feature: "Caspian Sea")], isolated: true,
            ice: Seasonal, ice_source: "WP 'Caspian Sea' (the north typically freezes in winter)"),
        // ---------------------------------- Atlantic ----------------------------------
        (key: "gulf_of_mexico", name: "Gulf of Mexico", parts: [(feature: "Gulf of Mexico"), (feature: "Bahía de Campeche")], ice: Free),
        (key: "caribbean_sea", name: "Caribbean Sea", parts: [(feature: "Caribbean Sea")], ice: Free),
        (key: "gulf_of_guinea", name: "Gulf of Guinea", parts: [(feature: "Gulf of Guinea"), (feature: "Bight of Benin"), (feature: "Bight of Biafra")], ice: Free),
        (key: "north_atlantic_west", name: "North Atlantic (west)", parts: [(feature: "Sargasso Sea"), (feature: "North Atlantic Ocean", lon: (-100.0, -45.0))], ice: Free),
        (key: "north_atlantic_central", name: "North Atlantic (central)", parts: [(feature: "North Atlantic Ocean", lon: (-45.0, -25.0))], ice: Free),
        (key: "north_atlantic_northeast", name: "North Atlantic (north-east)", parts: [(feature: "Bay of Biscay"), (feature: "Irish Sea"), (feature: "Inner Seas"), (feature: "North Atlantic Ocean", lon: (-25.0, 20.0), lat: (35.0, 90.0))], ice: Free),
        (key: "north_atlantic_southeast", name: "North Atlantic (south-east)", parts: [(feature: "North Atlantic Ocean")], ice: Free),
        (key: "south_atlantic_west", name: "South Atlantic (west)", parts: [(feature: "South Atlantic Ocean", lon: (-80.0, -20.0))], ice: Free),
        (key: "south_atlantic_east", name: "South Atlantic (east)", parts: [(feature: "South Atlantic Ocean")], ice: Free),
        // ---------------------------------- Indian Ocean ----------------------------------
        (key: "red_sea", name: "Red Sea", parts: [(feature: "Red Sea"), (feature: "Gulf of Suez"), (feature: "Gulf of Aqaba")], ice: Free),
        (key: "gulf_of_aden", name: "Gulf of Aden", parts: [(feature: "Gulf of Aden")], ice: Free),
        (key: "persian_gulf", name: "Persian Gulf", parts: [(feature: "Persian Gulf")], ice: Free),
        (key: "arabian_sea", name: "Arabian Sea", parts: [(feature: "Gulf of Oman"), (feature: "Arabian Sea"), (feature: "Laccadive Sea")], ice: Free),
        (key: "bay_of_bengal", name: "Bay of Bengal and Andaman Sea", parts: [(feature: "Bay of Bengal"), (feature: "Andaman Sea"), (feature: "Strait of Malacca")], ice: Free),
        (key: "indian_ocean_west", name: "Indian Ocean (west)", parts: [(feature: "Mozambique Channel"), (feature: "INDIAN OCEAN", lon: (20.0, 80.0))], ice: Free),
        (key: "south_australia", name: "Great Australian Bight", parts: [(feature: "Great Australian Bight"), (feature: "Bass Strait")], ice: Free),
        (key: "indian_ocean_east", name: "Indian Ocean (east)", parts: [(feature: "INDIAN OCEAN")], ice: Free),
        // ---------------------------------- South-East Asia and Australia ----------------------------------
        (key: "java_sea", name: "Java Sea", parts: [(feature: "Java Sea"), (feature: "Bali Sea"), (feature: "Flores Sea")], ice: Free),
        (key: "south_china_sea", name: "South China Sea", parts: [(feature: "South China Sea"), (feature: "Gulf of Thailand"), (feature: "Gulf of Tonkin")], ice: Free),
        (key: "sulu_celebes", name: "Sulu, Celebes and Banda Seas", parts: [(feature: "Sulu Sea"), (feature: "Celebes Sea"), (feature: "Makassar Strait"), (feature: "Molucca Sea"), (feature: "Banda Sea"), (feature: "Ceram Sea"), (feature: "Halmahera Sea"), (feature: "Savu Sea"), (feature: "Sibuyan Sea")], ice: Free),
        (key: "arafura_timor", name: "Arafura and Timor Seas", parts: [(feature: "Arafura Sea"), (feature: "Timor Sea"), (feature: "Gulf of Carpentaria")], ice: Free),
        (key: "coral_solomon", name: "Coral, Solomon and Bismarck Seas", parts: [(feature: "Coral Sea"), (feature: "Solomon Sea"), (feature: "Bismarck Sea")], ice: Free),
        (key: "tasman_sea", name: "Tasman Sea", parts: [(feature: "Tasman Sea")], ice: Free),
        // ---------------------------------- North-East Asia ----------------------------------
        (key: "east_china_sea", name: "East China Sea", parts: [(feature: "East China Sea")], ice: Free),
        (key: "yellow_sea", name: "Yellow Sea and Bo Hai", parts: [(feature: "Yellow Sea"), (feature: "Bo Hai")], ice: Free),
        (key: "sea_of_japan", name: "Sea of Japan", parts: [(feature: "Sea of Japan")],
            ice: Free, ice_source: "WP 'Peter the Great Gulf' (Vladivostok's gulf freezes early December to mid-April; Nakhodka Bay usually does not): the zone is free, the limitation is noted in the doc"),
        (key: "sea_of_okhotsk", name: "Sea of Okhotsk", parts: [(feature: "Sea of Okhotsk"), (feature: "Shelikhova Gulf"), (feature: "Gulf of Sakhalin"), (feature: "Tatar Strait")],
            ice: Seasonal, ice_source: "WP 'Sea of Okhotsk' (Sea ice: about December to early summer)"),
        (key: "bering_sea", name: "Bering Sea", parts: [(feature: "Bering Sea"), (feature: "Gulf of Anadyr'"), (feature: "Bristol Bay"), (feature: "Norton Sound")],
            ice: Seasonal, ice_source: "WP 'Bering Sea' (seasonal sea ice); NOAA 'Pribilof Islands … Role of Sea Ice' (heavy before 1977)"),
        (key: "philippine_sea", name: "Philippine Sea", parts: [(feature: "Philippine Sea")], ice: Free),
        // ---------------------------------- Pacific ----------------------------------
        (key: "north_pacific_west", name: "North Pacific (west)", parts: [(feature: "Inner Sea"), (feature: "North Pacific Ocean", lon: (120.0, 180.0))], ice: Free),
        (key: "north_pacific_east", name: "North Pacific (east)", parts: [(feature: "Gulf of Alaska"), (feature: "Golfo de California"), (feature: "North Pacific Ocean", lon: (-140.0, -70.0))], ice: Free),
        (key: "north_pacific_central", name: "North Pacific (central)", parts: [(feature: "North Pacific Ocean")], ice: Free),
        (key: "south_pacific_east", name: "South Pacific (east)", parts: [(feature: "South Pacific Ocean", lon: (-110.0, -65.0))], ice: Free),
        (key: "south_pacific", name: "South Pacific", parts: [(feature: "South Pacific Ocean")], ice: Free),
    ],
    straits: [
        (key: "gibraltar", name: "Strait of Gibraltar", kind: Strait, zones: ("north_atlantic_northeast", "western_mediterranean"),
            shores: ["GIB", "ESP-ANDALUCIA-OCCIDENTAL", "ESP-MARRUECOS"], regime: "No passage treaty in 1925 (the 1904 Entente Cordiale bars fortifying part of the Moroccan coast); transit passage under UNCLOS Part III (signed 1982-12-10, in force 1994-11-16). WP 'Strait of Gibraltar' (Territorial waters); WP 'Transit passage'",
            source: "Natural Earth 'Strait of Gibraltar'; shores from assets/map/provinces.ron"),
        (key: "dover", name: "Strait of Dover", kind: Strait, zones: ("north_sea", "english_channel"),
            shores: ["GBR-KENT-SUSSEX", "FRA-NORD"], regime: "Transit passage under UNCLOS Part III from 1994. WP 'Transit passage'",
            source: "shores from assets/map/provinces.ron"),
        (key: "oresund", name: "Øresund", kind: Strait, zones: ("kattegat", "baltic_south"),
            shores: ["DNK-SJAELLAND", "SWE-GOTALAND"], regime: "Copenhagen Convention of 1857 (signed 1857-03-14): Sound Dues abolished, free to all commercial shipping; silent on warships and war; kept by UNCLOS art. 35(c). WP 'Copenhagen Convention of 1857'; WP 'Transit passage'",
            source: "Natural Earth 'Øresund'; shores from assets/map/provinces.ron"),
        (key: "great_belt", name: "Great and Little Belts", kind: Strait, zones: ("kattegat", "baltic_south"),
            shores: ["DNK-SJAELLAND", "DNK-JYLLAND"], regime: "Copenhagen Convention of 1857, as the Øresund; the Belts are Danish territorial waters. WP 'Danish straits'",
            source: "shores from assets/map/provinces.ron (the Belts lie between Danish islands)"),
        (key: "kiel_canal", name: "Kiel Canal", kind: Canal, zones: ("north_sea", "baltic_south"),
            shores: ["DEU-SH"], opened: "1895-06-20", regime: "Treaty of Versailles arts. 380–386 (in force 1920-01-10): open to ships of all nations at peace with Germany; S.S. Wimbledon (PCIJ, 1923-08-17); repudiated by Germany in 1936. Avalon Project, Versailles Part XII s. VI; WP 'Kiel Canal'. Opening: WP 'Kiel Canal' (Construction and expansion)",
            source: "canal across Schleswig-Holstein; shore from assets/map/provinces.ron"),
        (key: "messina", name: "Strait of Messina", kind: Strait, zones: ("tyrrhenian_sea", "central_mediterranean"),
            shores: ["ITA-SICILIA", "ITA-CALABRIA"], regime: "Italian territorial waters; no passage treaty found",
            source: "shores from assets/map/provinces.ron"),
        (key: "otranto", name: "Strait of Otranto", kind: Strait, zones: ("adriatic_sea", "central_mediterranean"),
            shores: ["ITA-PUGLIE", "ALB"], regime: "No passage treaty found; transit passage under UNCLOS Part III from 1994",
            source: "shores from assets/map/provinces.ron"),
        (key: "corinth_canal", name: "Corinth Canal", kind: Canal, zones: ("central_mediterranean", "aegean_sea"),
            shores: ["GRC-PELOPONNISOS", "GRC-STEREA"], opened: "1893-07-25", regime: "Greek national canal, no treaty. Opening: WP 'Corinth Canal' (formally opened 1893-07-25, calendar not stated; navigation from November 1894)",
            source: "canal across the isthmus of Corinth; shores from assets/map/provinces.ron"),
        (key: "dardanelles", name: "Dardanelles", kind: Strait, zones: ("aegean_sea", "sea_of_marmara"),
            shores: ["TUR-BATI-MARMARA"], regime: "Lausanne Straits Convention (signed 1923-07-24, in force with the Treaty of Lausanne 1924-08-06): free passage, Turkey may stop only enemy ships when at war; replaced by the Montreux Convention (signed 1936-07-20, in force 1936-11-09), under which Turkey may close the Straits to warships in war or under threat. Wikisource 'Convention relating to the Straits'; WP 'Montreux Convention Regarding the Regime of the Straits'",
            source: "Natural Earth 'Dardanelles'; Çanakkale and Gallipoli in TUR-BATI-MARMARA"),
        (key: "bosporus", name: "Bosporus", kind: Strait, zones: ("sea_of_marmara", "black_sea"),
            shores: ["TUR-ISTANBUL"], regime: "Lausanne Straits Convention (1923), then the Montreux Convention (1936), as the Dardanelles",
            source: "Natural Earth 'Bosporus' (3 pixels: the texture does not join the seas)"),
        (key: "kerch", name: "Kerch Strait", kind: Strait, zones: ("black_sea", "sea_of_azov"),
            shores: ["RUS-KRYM", "RUS-KUBAN"], regime: "Russia–Ukraine agreement on the Sea of Azov and the Kerch Strait (signed 2003-12-24, in force 2004-04-23; denounced 2023): third-state warships pass only with consent. WP 'Treaty Between the Russian Federation and Ukraine on Cooperation in the Use of the Sea of Azov and the Kerch Strait'",
            source: "shores from assets/map/provinces.ron"),
        (key: "suez_canal", name: "Suez Canal", kind: Canal, zones: ("eastern_mediterranean", "red_sea"),
            shores: ["EGY-EASTERN-DELTA"], opened: "1869-11-17", regime: "Convention of Constantinople (signed 1888-10-29, in force 1904-04-08): passage in war and peace, art. X lets Egypt act for its defence; British reserved points of 1922-02-28; Anglo-Egyptian Treaty of 1936; nationalised 1956-07-26. WP 'Convention of Constantinople'; WP 'Unilateral Declaration of Egyptian Independence'; WP 'Suez Canal'. Opening: WP 'Suez Canal' (Inauguration)",
            holders: [(tag: "GBR", from: "1922-02-28", until: "1956-06",
                source: "British troops guard the canal: reserved point (a) of the Unilateral Declaration of Egyptian Independence (1922-02-28), then the Anglo-Egyptian Treaty of 1936; withdrawal completed in June 1956. WP 'Unilateral Declaration of Egyptian Independence' (Text); WP 'Anglo-Egyptian treaty of 1936' (Treaty provisions; Aftermath)")],
            source: "Port Said, Ismailia and Suez are in EGY-EASTERN-DELTA (assets/map/provinces.ron)"),
        (key: "bab_el_mandeb", name: "Bab-el-Mandeb", kind: Strait, zones: ("red_sea", "gulf_of_aden"),
            shores: ["YEM", "YEM-ADEN", "DJI", "ERI"], regime: "No passage treaty; transit passage under UNCLOS Part III from 1994. WP 'Bab-el-Mandeb'",
            source: "Natural Earth 'Bab el Mandeb'; shores from assets/map/provinces.ron"),
        (key: "hormuz", name: "Strait of Hormuz", kind: Strait, zones: ("persian_gulf", "arabian_sea"),
            shores: ["IRN-KERMAN", "OMN"], regime: "No passage treaty; a 1968 traffic separation scheme with Oman; transit passage under UNCLOS Part III, contested by Iran and Oman. WP 'Strait of Hormuz' (Navigation)",
            source: "shores from assets/map/provinces.ron (Bandar Abbas; Musandam)"),
        (key: "malacca", name: "Strait of Malacca and Singapore", kind: Strait, zones: ("bay_of_bengal", "south_china_sea"),
            shores: ["MYS-STRAITS", "MYS-FMS", "IDN-OOSTKUST", "IDN-MIDDEN-SUMATRA"], regime: "No passage treaty found; transit passage under UNCLOS Part III from 1994. WP 'Strait of Malacca'; WP 'Transit passage'",
            source: "Natural Earth 'Strait of Malacca', 'Strait of Singapore'; shores from assets/map/provinces.ron"),
        (key: "sunda", name: "Sunda Strait", kind: Strait, zones: ("java_sea", "indian_ocean_east"),
            shores: ["IDN-BANTAM", "IDN-ZUID-SUMATRA"], regime: "No passage treaty found",
            source: "shores from assets/map/provinces.ron (Banten, Lampung)"),
        (key: "lombok", name: "Lombok Strait", kind: Strait, zones: ("java_sea", "indian_ocean_east"),
            shores: ["IDN-BALI-LOMBOK"], regime: "No passage treaty found",
            source: "between Bali and Lombok, both in IDN-BALI-LOMBOK"),
        (key: "tsushima", name: "Korea Strait (Tsushima)", kind: Strait, zones: ("east_china_sea", "sea_of_japan"),
            shores: ["KOR-GYEONGNAM", "JPN-KITA-KYUSHU", "JPN-SAIKAI"], regime: "No passage treaty found",
            source: "Natural Earth 'Korea Strait'; shores from assets/map/provinces.ron (Pusan; Fukuoka; Nagasaki with Tsushima)"),
        (key: "tsugaru", name: "Tsugaru Strait", kind: Strait, zones: ("sea_of_japan", "north_pacific_west"),
            shores: ["JPN-HOKKAIDO", "JPN-OU"], regime: "No passage treaty found",
            source: "Natural Earth 'Tsugaru Strait'; Aomori in JPN-OU"),
        (key: "la_perouse", name: "La Pérouse Strait (Sōya)", kind: Strait, zones: ("sea_of_japan", "sea_of_okhotsk"),
            shores: ["JPN-HOKKAIDO", "RUS-KARAFUTO"], regime: "No passage treaty found",
            source: "Natural Earth 'La Pérouse Strait'; shores from assets/map/provinces.ron"),
        (key: "tatar", name: "Strait of Tartary", kind: Strait, zones: ("sea_of_japan", "sea_of_okhotsk"),
            shores: ["RUS-KHABAROVSK", "RUS-SAK"], regime: "No passage treaty found",
            source: "Natural Earth 'Tatar Strait'; shores from assets/map/provinces.ron"),
        (key: "bering", name: "Bering Strait", kind: Strait, zones: ("bering_sea", "chukchi_sea"),
            shores: ["USA-AK", "RUS-MAGADAN"], regime: "No passage treaty found",
            source: "shores from assets/map/provinces.ron (Alaska; Chukotka)"),
        (key: "magellan", name: "Strait of Magellan", kind: Strait, zones: ("south_atlantic_west", "south_pacific_east"),
            shores: ["CHL-SUR"], regime: "Chile–Argentina Boundary Treaty of 1881 (signed 1881-07-23), art. V: neutralised for ever, free navigation for all flags, no fortifications; confirmed by the Treaty of Peace and Friendship of 1984. WP 'Boundary treaty of 1881 between Chile and Argentina'",
            source: "Natural Earth 'Estrecho de Magellanes'; Magallanes in CHL-SUR; the way round Cape Horn stays an open contact"),
        (key: "panama_canal", name: "Panama Canal", kind: Canal, zones: ("caribbean_sea", "north_pacific_east"),
            shores: ["PAN"], opened: "1914-08-15", regime: "Hay–Pauncefote Treaty (1901-11-18) and Hay–Bunau-Varilla Treaty (signed 1903-11-18, in force 1904-02-26): Canal Zone under US control, neutral, US may protect it (art. XXIII); Torrijos–Carter Treaties (signed 1977-09-07, in force 1979-10-01), canal to Panama on 1999-12-31. WP 'Hay–Bunau-Varilla Treaty'; Avalon Project text; WP 'Torrijos–Carter Treaties'. Opening: WP 'Panama Canal' (SS Ancon, 1914-08-15)",
            holders: [(tag: "USA", from: "1904-02-26", until: "1999-12-31",
                source: "Canal Zone under United States control, with the rights of a sovereign and the right to protect the canal (Hay–Bunau-Varilla Treaty, in force 1904-02-26, arts. III and XXIII), until the transfer to Panama at noon on 1999-12-31 (Torrijos–Carter Treaties). WP 'Hay–Bunau-Varilla Treaty'; Avalon Project text; WP 'Torrijos–Carter Treaties'")],
            source: "the Canal Zone is not a state of the map: the shore is PAN and the United States hold it by treaty (docs/map-pipeline.pt-BR.md, 'Quem controla')"),
    ],
)
