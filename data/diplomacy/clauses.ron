// Between Frontiers: the clause catalogue of treaties (phase 4). Contract:
// crates/bf-sim/src/treaty.rs (ClauseCatalogue). Design and sources: docs/treaties.pt-BR.md.
// Licence: CC BY-SA 4.0.
//
// - `once`: acts on entry into force; otherwise holds while the treaty is in force.
// - `needs`: the fronts of the simulation the clause needs. A clause whose front is not live is
//   dormant: signed and shown, with no effect, and the screen says what wakes it (`front-<key>`).
// - `sovereignty` (points the giver yields) and `concerns` (what the interest groups weigh, for
//   the giver, -3 to 3, on the effects of politics::EFFECTS plus `sovereignty` and `burden`) are
//   DESIGN CHOICES, to be balanced after phase 6. `source` names the historical cases the clause
//   stands for, not the numbers.
// - `policy`: the owner's switches (decisions 3 to 6 of the design), as decided on 2026-11-17.
(
    clauses: [
        (key: "cede_states", once: true, needs: [Borders], sovereignty: 0,
            concerns: [("sovereignty", -3)],
            source: "Versailles part II-III; Alaska purchase (1867); Virgin Islands (1917)"),
        (key: "release_country", once: true, needs: [Borders], sovereignty: 0,
            concerns: [("sovereignty", -2), ("colonial_tribute", -1)],
            source: "Philippines (Treaty of Manila, 1946); Evian (1962); Iraq (1932)"),
        (key: "union", once: true, needs: [Borders], sovereignty: 0,
            concerns: [("sovereignty", -3)],
            source: "union of Hejaz and Nejd (1932); Tanganyika and Zanzibar (1964)"),
        (key: "debt", once: true, needs: [Ledger], sovereignty: 0,
            concerns: [("burden", -2)],
            source: "Versailles arts. 231-235; London Schedule (1921); Dawes (1924); Young (1929); Haiti (1825)"),
        (key: "assume_debt", once: true, needs: [Ledger], sovereignty: 0,
            concerns: [("burden", -2)],
            source: "Dutch-Indonesian Round Table (1949)"),
        (key: "revise_debt", once: true, needs: [Ledger], sovereignty: 0,
            concerns: [("burden", 2)],
            source: "Hoover moratorium (1931); Lausanne (1932)"),
        (key: "payment", once: true, needs: [], sovereignty: 0,
            concerns: [("burden", -1)],
            source: "Alaska (1867, US$ 7.2 million); Virgin Islands (1917, US$ 25 million)"),
        (key: "techniques", once: true, needs: [Research], sovereignty: 0,
            concerns: [],
            source: "docs/borders.pt-BR.md, decision 6 (technique terms)"),
        (key: "recognition", once: false, needs: [Recognition], sovereignty: 0,
            concerns: [],
            source: "Montevideo Convention (1933) art. 3; Hallstein doctrine; Basic Treaty (1972)"),
        (key: "non_aggression", once: false, needs: [War], sovereignty: 0,
            concerns: [],
            source: "Soviet-Polish non-aggression pact (1932); Kellogg-Briand (1928)"),
        (key: "defence", once: false, needs: [War], sovereignty: 1,
            concerns: [("conscription", 1)],
            source: "North Atlantic Treaty (1949) art. 5; Warsaw Pact (1955) art. 4; Franco-Polish alliance (1921)"),
        (key: "consultation", once: false, needs: [War], sovereignty: 0,
            concerns: [],
            source: "Four-Power Treaty (1921); Finno-Soviet treaty (1948) art. 2"),
        (key: "border_guarantee", once: false, needs: [War], sovereignty: 0,
            concerns: [],
            source: "Locarno Rhineland Pact (1925)"),
        (key: "demilitarized", once: false, needs: [War], sovereignty: 2,
            concerns: [("sovereignty", -2)],
            source: "Versailles arts. 42-43 (Rhineland); Lausanne (1923, the Straits)"),
        (key: "arms_limit", once: false, needs: [War], sovereignty: 1,
            concerns: [("sovereignty", -1)],
            source: "Versailles arts. 160, 181, 191, 198; Washington Naval Treaty (1922) arts. IV and VII"),
        (key: "base", once: false, needs: [War], sovereignty: 2,
            concerns: [("sovereignty", -2)],
            source: "Guantanamo (1903); Anglo-Iraqi treaty (1930); Philippine bases (1947); Evian (1962)"),
        (key: "passage", once: false, needs: [War], sovereignty: 1,
            concerns: [("sovereignty", -1)],
            source: "Anglo-Iraqi treaty (1930); Montreux Convention (1936)"),
        (key: "occupation", once: false, needs: [War], sovereignty: 3,
            concerns: [("sovereignty", -3)],
            source: "Rhineland occupation (1920-1930); Ruhr (1923-1925)"),
        (key: "tariff_cap", once: false, needs: [Trade], sovereignty: 1,
            concerns: [("tariff", -1)],
            source: "Nine-Power Treaty (1922, open door); Lausanne (1923, Ottoman tariff frozen)"),
        (key: "tariff_preference", once: false, needs: [Trade], sovereignty: 0,
            concerns: [("tariff", -1)],
            source: "Bell Trade Act (1946); imperial preference"),
        (key: "customs_union", once: false, needs: [Trade], sovereignty: 1,
            concerns: [("tariff", -1)],
            source: "Zollverein (1834); Belgium-Luxembourg union (1921); Benelux (1944); EEC (1957)"),
        (key: "currency_peg", once: false, needs: [Money], sovereignty: 1,
            concerns: [],
            source: "CFA franc (1945, operations account); Bell Trade Act (peso at 2 per dollar); sterling area"),
        (key: "monetary_union", once: false, needs: [Money], sovereignty: 2,
            concerns: [],
            source: "Latin Monetary Union (1865-1927); Maastricht criteria (1992)"),
        (key: "capital_protection", once: false, needs: [ForeignCapital], sovereignty: 1,
            concerns: [("foreign_investment", 1)],
            source: "Lancaster House (1979, compensation clause); Evian (1962, property guarantees)"),
        (key: "financial_control", once: false, needs: [Ledger], sovereignty: 2,
            concerns: [("sovereignty", -2)],
            source: "Dawes (1924, Agent-General and Transfer Committee); Haitian-American convention (1915); Dominican receivership (1907)"),
        (key: "tribute", once: false, needs: [Ledger], sovereignty: 1,
            concerns: [("burden", -1), ("colonial_tribute", 1)],
            source: "Hay-Bunau-Varilla (1903, yearly payment for the zone); Guantanamo lease"),
        (key: "foreign_policy", once: false, needs: [], sovereignty: 3,
            concerns: [("sovereignty", -3), ("colonial_self_rule", -1)],
            source: "Platt Amendment art. I (1903); Anglo-Kuwaiti agreement (1899); Treaty of Punakha (1910)"),
        (key: "intervention", once: false, needs: [Politics], sovereignty: 3,
            concerns: [("sovereignty", -3)],
            source: "Platt Amendment art. III; Russo-Persian treaty (1921) art. 6; Brezhnev doctrine (1968)"),
        (key: "minorities", once: false, needs: [Communities], sovereignty: 1,
            concerns: [("discrimination", -1)],
            source: "minority treaties of 1919; Egypt 1922 reserved point (c); Evian (1962, guarantees to Europeans)"),
        (key: "troops_quota", once: false, needs: [War], sovereignty: 2,
            concerns: [("conscription", 1), ("sovereignty", -1)],
            source: "Anglo-Iraqi treaty (1930); Warsaw Pact; Indian Army in the British wars"),
        (key: "offence", once: false, needs: [War], sovereignty: 1,
            concerns: [("conscription", 2)],
            source: "ATOP v5.1 offence obligation (Leeds, Ritter, Mitchell and Long 2002); Pact of Steel (1939) art. III"),
        (key: "neutrality", once: false, needs: [War], sovereignty: 0,
            concerns: [],
            source: "ATOP v5.1 neutrality obligation (Leeds and others 2002); COW Formal Alliances v4.1 type IIa (Gibler 2009)"),
    ],
    // Subject grades as bundles of clauses: the subject gives, the overlord receives, unless the
    // line says `overlord_gives`. Docs: treaties.pt-BR.md, section 7.
    bundles: [
        (key: "crown_colony", grades: [CrownColony],
            clauses: [(clause: "foreign_policy"), (clause: "base"), (clause: "troops_quota"),
                (clause: "tariff_preference"), (clause: "currency_peg"), (clause: "tribute"),
                (clause: "intervention"), (clause: "defence", overlord_gives: true)],
            source: "the Raj: a separate administration under the Crown, with the Indian Army at its disposal"),
        (key: "protectorate", grades: [Protectorate],
            clauses: [(clause: "foreign_policy"), (clause: "base"), (clause: "tariff_cap"),
                (clause: "currency_peg"), (clause: "intervention"),
                (clause: "defence", overlord_gives: true)],
            source: "Anglo-Kuwaiti agreement (1899); Treaty of Punakha (1910); Muscat (1891)"),
        (key: "mandate", grades: [Mandate],
            clauses: [(clause: "foreign_policy"), (clause: "base"), (clause: "tariff_cap"),
                (clause: "intervention"), (clause: "defence", overlord_gives: true)],
            source: "Covenant of the League of Nations art. 22; Anglo-Iraqi treaty (1922)"),
        (key: "dominion", grades: [Dominion],
            clauses: [(clause: "consultation"), (clause: "tariff_preference"),
                (clause: "currency_peg"), (clause: "defence", overlord_gives: true)],
            source: "Balfour Declaration (1926); Statute of Westminster (1931) ss. 2, 4, 10"),
        (key: "satellite", grades: [Satellite],
            clauses: [(clause: "foreign_policy"), (clause: "base"), (clause: "troops_quota"),
                (clause: "customs_union"), (clause: "intervention"),
                (clause: "defence", overlord_gives: true)],
            source: "Soviet-Mongolian agreement (1921); Warsaw Pact stationing agreements (1957); Brezhnev doctrine"),
    ],
    policy: (
        subject_exit: PressureOverControl,
        recognition_default: AllExceptListed,
        ratify_below_threshold: PlayerOnly,
        war_debts_1925: true,
    ),
    weights: (
        // DESIGN CHOICE: one point of sovereignty is worth 1 % of the giver's yearly GDP.
        sovereignty_point: "0.010",
        // DESIGN CHOICE: a clause without a term is valued over 20 years.
        horizon_years: 20,
        // As the default history of the debt (state.pt-BR.md): 10 % a year.
        reputation_decay: "0.100",
    ),
)
