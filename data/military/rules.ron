// Between Frontiers: combat and logistics rules of the war (phase 5, not wired into the
// simulation yet). Contract: crates/bf-sim/src/war/catalogue.rs (RulesFile); reasoning in
// docs/war.pt-BR.md. Licence: CC BY-SA 4.0.
//
// Every number here is a DESIGN PARAMETER, not a historical figure: an order of magnitude to be
// calibrated against the wars of the century once the war runs (docs/war.pt-BR.md, "Calibração
// prevista"). Per-mille fields are integers; Fixed fields take an integer or a decimal string.
(
    ammunition_good: "ammunition",
    fuel_good: "fuel",
    armor_good: "armored_vehicles",

    // Land fire per unit held. A lot of small arms is the unit; a lot of guns hits four times as
    // hard, of armour three times (it also protects), of electronics (fire control, guided
    // weapons) twice. Lorries, tools and machinery carry and build; they add no fire.
    fire_per_unit: [
        ("small_arms", 1),
        ("artillery", 4),
        ("armored_vehicles", 3),
        ("electronic_components", 2),
        ("electrical_equipment", 1),
    ],
    // Fire of one element of 1925 infantry (units.ron: 100 small arms + 20 artillery).
    reference_fire: 180,

    // Tonnes per unit of each good a force consumes. Goods sold by the tonne weigh one; lots of
    // US$ 1,000 weigh what a thousand dollars of the good weighed in 1925, roughly: a tonne of
    // shells, half a tonne of uniforms, a fifth of a tonne of spare parts.
    tonnes_per_unit: [
        ("processed_food", 1),
        ("grain", 1),
        ("maize", 1),
        ("fuel", 1),
        ("coal", 1),
        ("ammunition", 1),
        ("clothes", "0.5"),
        ("medicines", "0.2"),
        ("small_arms", "0.5"),
        ("artillery", "0.5"),
        ("armored_vehicles", "0.5"),
        ("military_aircraft", "0.2"),
        ("warships", "0.5"),
        ("automobiles", "0.5"),
        ("tools", "0.5"),
        ("machinery", "0.3"),
        ("engines", "0.3"),
        ("ships", "0.5"),
        ("electrical_equipment", "0.2"),
        ("electronic_components", "0.05"),
        ("nuclear_fuel", "0.001"),
        ("explosives", "0.5"),
    ],
    // 2 per mille of the equipment value a week: about a tenth a year, the order of the spares
    // and overhaul budgets of standing forces.
    maintenance_per_mille: 2,
    combat_ammunition: 10,
    moving_fuel: 3,

    // An element all in armour is 80 % protected, capped at 60 %.
    protection_per_armor_share: 800,
    protection_max: 600,

    // A force with no training fights at half strength; with no ammunition, at a quarter (the
    // bayonet, the reserve in the pouch).
    training_floor: 500,
    supply_floor: 250,
    // Losing the sky entirely costs a quarter of the power.
    air_weight: 250,
    // Full fortification doubles the defender's terrain: a trench system with wire and machine
    // guns, the Western Front's (the tick digs a still segment in, "front" below).
    fortification_bonus: 1000,

    // At even power a side loses 1.5 % of its men a week in combat; at most twice that.
    land_lethality: "0.015",
    // At even strike a fleet loses 3 % of its tonnage a week of action; at most twice that.
    naval_lethality: "0.03",
    // At even superiority an air force loses 4 % of its aircraft a week of contest.
    air_lethality: "0.04",

    service_age: (18, 45),
    // A fifth of the men called up stay in essential work (mines, railways, arms plants).
    reserved_share: 200,

    // Loss per 1,000 km: the lorry burns a tenth of what it carries; the rest lose little.
    mode_loss: [
        (Rail, 10),
        (Road, 100),
        (River, 20),
        (Sea, 10),
        (Air, 200),
    ],
    // Tonne-kilometres moved by one lot of the `transportation` good (US$ 1,000 at base price):
    // about two cents a tonne-kilometre, the order of rail freight in the 1920s.
    tkm_per_transport_lot: 50000,

    // Terrain: the defender's factor, and the attacker's and the speed by mobility.
    terrain: [
        (terrain: Open, defense: 1),
        (terrain: Forest, defense: "1.25",
            attack: [(Wheeled, "0.8"), (Tracked, "0.7"), (Horse, "0.8")],
            speed: [(Wheeled, "0.6"), (Tracked, "0.6"), (Horse, "0.7")]),
        (terrain: Jungle, defense: "1.5",
            attack: [(Foot, "0.8"), (Wheeled, "0.5"), (Tracked, "0.5"), (Horse, "0.6")],
            speed: [(Foot, "0.6"), (Light, "0.8"), (Wheeled, "0.4"), (Tracked, "0.4"), (Horse, "0.5")]),
        (terrain: Desert, defense: "1.1",
            attack: [(Foot, "0.9")],
            speed: [(Foot, "0.7"), (Light, "0.7"), (Horse, "0.8")]),
        (terrain: Arctic, defense: "1.2",
            attack: [(Foot, "0.8"), (Wheeled, "0.7"), (Tracked, "0.8"), (Horse, "0.6")],
            speed: [(Foot, "0.6"), (Wheeled, "0.5"), (Tracked, "0.6"), (Horse, "0.5")]),
        (terrain: Mountain, defense: 2,
            attack: [(Foot, "0.8"), (Wheeled, "0.5"), (Tracked, "0.4"), (Horse, "0.6")],
            speed: [(Foot, "0.5"), (Light, "0.8"), (Wheeled, "0.4"), (Tracked, "0.3"), (Horse, "0.5")]),
        (terrain: Marsh, defense: "1.3",
            attack: [(Wheeled, "0.6"), (Tracked, "0.5"), (Horse, "0.7")],
            speed: [(Foot, "0.6"), (Wheeled, "0.4"), (Tracked, "0.3"), (Horse, "0.5")]),
        (terrain: Urban, defense: "1.5",
            attack: [(Tracked, "0.7"), (Horse, "0.6")],
            speed: [(Foot, "0.5"), (Light, "0.5"), (Wheeled, "0.5"), (Tracked, "0.5"), (Horse, "0.5")]),
    ],

    // Köppen classes of data/scenario/1925/land.ron → terrain. Forest comes from forest_km2.
    climate_terrain: [
        ("tropical_rainforest", Jungle),
        ("tropical_monsoon", Jungle),
        ("tropical_savanna", Open),
        ("hot_desert", Desert),
        ("cold_desert", Desert),
        ("hot_steppe", Open),
        ("cold_steppe", Open),
        ("mediterranean", Open),
        ("humid_subtropical", Open),
        ("oceanic", Open),
        ("humid_continental", Open),
        ("subarctic", Arctic),
        ("tundra", Arctic),
        ("ice_cap", Arctic),
    ],

    // Kilometres a week an attacker breaking through on open ground can cover.
    speed_km_week: [
        (Static, 0),
        (Foot, 40),
        (Light, 40),
        (Horse, 70),
        (Wheeled, 150),
        (Tracked, 150),
    ],
    // A landing attacks at 60 % on top of the terrain.
    amphibious: 600,
    // A segment whose whole border runs along a big river (terrain.ron) gives the defender 30 %
    // more on top of the terrain (design parameter).
    river_defense: 300,
    // People per km² of urbanized area, to turn the urban population of population.ron into the
    // urban share of a state's terrain. Angel et al. 2010, "Persistent Decline in Urban
    // Densities" (Lincoln Institute), Annex IV p. 133: the average density of the urbanized area of
    // 30 cities was 238 people per hectare in 1920 and 207 in 1930; 1925 taken midway. Those are
    // large cities; smaller towns are less dense, so this tends to understate the urban share.
    urban_density_km2: 22000,
    winter: (upkeep: "1.3", speed: "0.6"),
    // Every segment holds at least 2 % of the front's elements; the objective doubles a weight.
    allocation: (min_share: 20, objective_pull: 1000),
    exhaustion: (
        casualties: 600,
        mobilization: 200,
        shortage: 300,
        occupation: 400,
        duration_per_year: 40,
        industry: 200,
        // A year of output spent on the war is 300 points; a doubling of prices, 200: a long
        // war exhausts the side that is winning it too.
        spending: 300,
        prices: 200,
    ),
    invalid_share: 150,

    // Generations of war (docs/war.pt-BR.md, "Doutrina"). Readiness points at a full share of
    // each cause; an army moves to the third generation at 650 and falls back below 450. The
    // weights follow the sources: ideas and the officer corps first (Lind et al. 1989, p. 23;
    // Lind 1985), the tank as what made it operational (Lind 1989, p. 23); radio and motor
    // vehicles are means, not causes, and weigh less. The culture of order (obedience over
    // initiative, zero defects, purges) takes points away (Lind 2004; Lind 1985, PT73).
    doctrine: (
        officer_education: 350,
        training: 200,
        radio: 100,
        motorization: 150,
        experience: 200,
        central_control: 400,
        up: 650,
        down: 450,
        // Below half its radio or half its fuel, a third-generation force fights as a second.
        radio_min: 500,
        fuel_min: 500,
        // Six tenths of the free elements on the focus segment.
        focus_share: 600,
        // Three times the defender's power, its reserve included, breaks the segment.
        breakthrough_ratio: 3,
        exploitation_speed: 2,
        // A year of war gives the full experience term, which halves in five years of peace
        // (design values: the lessons of one war are mostly gone by the next generation of
        // officers, Murray and Millett 1996 on the interwar years).
        experience_full_weeks: 52,
        experience_half_life_years: 5,
        // The officer corps answers to politics for five years after a change of the form of
        // government (purges and commissars; design value). The regime itself is not a term:
        // the German army of 1939–41, under a dictatorship, commanded by mission; the French of
        // 1940, under a democracy, fought a methodical battle from the centre.
        politicized_years: 5,
    ),

    // Command culture (decision G7, draft; docs/war.pt-BR.md, "Geração do exército"): the share
    // of the officer corps formed to act on the commander's intent in 1925. Design values from
    // the institution each army was in 1925, not from what it became; what it becomes comes
    // out of the game. Armies not listed read the schooling of their people.
    command: (
        tradition_1925: [
            // The Reichswehr of Seeckt (1920-26): an army of leaders, command by mission
            // (Corum, The Roots of Blitzkrieg, 1992; Citino, The Path to Blitzkrieg, 1999).
            ("GER", 700),
            // The Field Service Regulations of 1924 and the experimental mechanised force to come
            // (French, Raising Churchill's Army, 2000): between the two.
            ("GBR", 400),
            // Frunze's reforms; deep operations only from 1929 (Triandafillov) and PU-36 (Glantz,
            // Soviet Military Operational Art, 1991).
            ("SOV", 350),
            // The provisional instruction of 1921 and the methodical battle, run from the centre
            // (Doughty, The Seeds of Disaster, 1985).
            ("FRA", 200),
        ],
        // An army without a recorded tradition counts half the schooling of its people (design
        // value): otherwise a literate country without a staff school (Poland, 0.79 in 1939)
        // would out-rank the Reichswehr's 0.7.
        untraditioned_share: 500,
        // A career of 25 years: a twenty-fifth of the corps a year (design value).
        officer_career_years: 25,
        doctrine_tech: "armored_warfare",
        // After a defeat the schools revise the doctrine (the Reichswehr after 1918): cohorts
        // twice as fast for ten years (design values).
        defeat_reform_speed: 2,
        reform_years: 10,
    ),

    // Nuclear deterrence (docs/war.pt-BR.md, "Arma nuclear").
    nuclear: (
        silo_kill: 500,
        soft_kill: 900,
        bomber_penetration: 600,
        // Half a percent a week of direct war between two secure nuclear powers.
        escalation_risk_per_week: 5,
        // The balance read from the forces (docs/war.pt-BR.md, "Arma nuclear na escada de
        // crise"). N3 (to the owner): an untested arsenal counts half for the others.
        opaque_weight: 500,
        // N9 (to the owner): the protectors bound by a defence clause add their arsenals.
        umbrella: true,
        // Unacceptable damage: a quarter of the people, at 185,000 dead a warhead of 1 Mt
        // equivalent (McNamara's assured destruction; Enthoven and Smith, 1971, How Much Is
        // Enough?).
        unacceptable_share: 250,
        killed_per_warhead: 185000,
        warheads_per_bomber: 2,
        warheads_per_missile: 1,
        warheads_per_submarine: 16,
        // Half the missile submarines at sea; no bomber on alert until the doctrine says so.
        bomber_alert: 0,
        submarine_alert: 500,
        command: 900,
        interceptors_per_site: 100,
        interceptor_kill: 500,
    ),

    // The reserve reports in four weeks, at seven tenths of full training (a reservist keeps
    // part of what he learned; design parameter).
    reserve: (call_up_weeks: 4, training: 700),

    // The pace of a front (docs/war.pt-BR.md, "Ritmo da frente"). A full line is some 600 men
    // per km, a division per 25 km, the least a coherent defence holds (Mearsheimer, 1989,
    // "Assessing the Conventional Balance", International Security 13(4)). Denser, the attacker
    // slows down to a tenth (the Western Front, 1915–17: thousands of men per km); thinner, it
    // runs up to 1.75 times its speed, the pursuit of a broken army on foot (the Romanian
    // advance on Budapest in 1919, about 100 km in ten days). The factor goes with the square
    // of the ratio: the Somme's 3,300 men per km against 600 give a thirtieth, about half a km a
    // week (Prior and Wilson, The Somme, 2005). Ten still weeks dig a front in.
    front: (
        full_line_men_km: 600,
        density_min: "0.1",
        density_max: "1.75",
        density_power: 2,
        dig_weeks: 10,
        still_km: 2,
        // Pursuit: a side that advanced last week and attacks with 1.5 times the defender's
        // power marches on at its marching pace (the same ratio the AI attacks at, G5; design
        // value).
        pursuit_ratio: "1.5",
    ),

    // units.ron counts these goods in lots of 1925 dollars; the economy prices them in 2011
    // dollars (data/economy/goods.ron, "lot worth $1,000"). Factor: CPI-U of the BLS, 1925 to
    // 2011, the one docs/economy.pt-BR.md uses for the price of a car. Their quantities are
    // multiplied by it on load; their weight per lot and their fire per lot are divided by it,
    // so the logistics and the combat do not change.
    dollars_1925: Some((
        factor: "12.85",
        goods: [
            "small_arms", "ammunition", "artillery", "armored_vehicles", "warships",
            "military_aircraft", "automobiles", "tools", "machinery", "engines", "ships",
            "electrical_equipment", "electronic_components", "clothes", "medicines",
        ],
    )),
)
