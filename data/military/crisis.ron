// Between Frontiers: crisis and declaration (phase 5, slice B, draft). Contract:
// crates/bf-sim/src/war/crisis.rs (CrisisRules); reasoning in docs/war.pt-BR.md, "Crise e
// declaração". Licence: CC BY-SA 4.0.
//
// Owner's decisions of 2026-11-17: W2, a deadline of 4 weeks; W3, the force weighs against the
// share asked for, and an existential demand is never yielded. Design values.
(
    deadline_weeks: 4,
    // A peripheral demand is yielded to three times the target's land force.
    yield_ratio: 3000,
    // From half the country (its people in the states asked for, or the money over its GDP),
    // the demand is existential.
    existential_share: 500,
    // Third parties (W4): weeks the player has to answer a call to war by an agreement in force,
    // and whether a call left to lapse is honoured (owner's decision P2: betraying is a decision,
    // honouring the default) or betrayed.
    call_weeks: 2,
    lapsed_call_honours: true,
    // N4 with N10 (the owner, 2026-11-19: (a), symmetric): on a peripheral demand, the one-sided
    // nuclear advantage of the demander (its second strike's delivered warheads over the
    // target's unacceptable damage, as the target reads it) adds to the ratio of force, and the
    // target's own subtracts; an existential demand is never yielded.
    nuclear_term: true,
    // W3's force is combat power (the fire of the land equipment times the training), not men.
    // Across the sea (no land border), the demander's counts by its share of the two navies'
    // tonnage times sea_full per mille, at most whole. DESIGN VALUE.
    sea_full: 2000,
)
