// Between Frontiers: the conduct of the war, war support and occupation (phase 5, slice C,
// draft). Contract: crates/bf-sim/src/war/support.rs (ConductFile); reasoning in
// docs/war.pt-BR.md, "Apoio à guerra" and "Ocupação". Licence: CC BY-SA 4.0.
//
// Behind the switch `war`. The owner chose the recommended option in A1–A3 and O1–O3
// (2026-11-18); each is kept here as data. Per mille unless named otherwise.
(
    support: (
        // At the declaration: rallying round the flag for the country attacked (Mueller, 1973,
        // *War, Presidents and Public Opinion*); a cause on record helps the one that declared.
        attacked: 800,
        attacker_cause: 600,
        attacker_no_cause: 400,
        colonial: 550,
        // A1, by interest group (recommended): the military above, those who give the soldiers
        // below. The mean weighs each group by its clout.
        groups: [
            ("military", 150),
            ("officialdom", 50),
            ("landed_estates", 50),
            ("business", 0),
            ("churches", 0),
            ("professional_classes", -20),
            ("workers", -80),
            ("peasantry", -60),
        ],
        // The log of the killed (Mueller, 1973; Gartner and Segura, 1998, *Journal of Conflict
        // Resolution* 42(3)): per tenfold of the killed per million.
        casualties_per_decade: 60,
        duration_per_year: 30,
        // G8 (the owner, 2026-11-19): the duration weighs by the share of the land army
        // committed to the war, times `commitment_factor`, at most whole.
        duration_by_commitment: true,
        // The weight is the share of the land army committed times this factor, per mille, at
        // most whole: with 3, Vietnam (some 0.36 of the army) weighs whole and the owner's case
        // stands; Malaya (some 0.05) weighs about 0.15.
        commitment_factor: 3000,
        // G9 (the owner, 2026-11-19: on, the threshold of 500 per mille with the capital kept):
        // a state's people count as under the enemy in proportion to the enemy's advance over
        // the state's depth, before the state changes hands; off, all at once when it does.
        occupation_by_advance: true,
        // Civilian deprivation counts (orchestrator, 2026-11-18): the share of the basic needs
        // met before the war that are no longer met. Germany's turnip winter of 1916–17 and the
        // strikes of 1918 (Offer, 1989, *The First World War: An Agrarian Interpretation*).
        deprivation: 600,
        territory: 500,
        // The expectation of victory weighs more than the dead (Gelpi, Feaver and Reifler,
        // 2009, *Paying the Human Costs of War*): the front's course, km a week, smoothed.
        result_per_km: 30,
        result_cap: 150,
        result_weeks: 13,
        // A2: free elections hasten the fall (Reiter and Stam, 2002, *Democracies at War*);
        // censorship slows it, and the fall comes all at once at the end.
        speed: 40,
        free_vote: 500,
        censorship: 600,
        peace: 300,
        collapse: 100,
        ask_weeks: 8,
        // From the collapse to the fall: Ludendorff asked for an armistice at the end of
        // September 1918, the Kaiser abdicated on 9 November.
        revolution_weeks: 6,
        // A country overrun falls at once: nine tenths of its metropolitan people under the
        // enemy, or half of them with the capital (Hungary in August 1919: the Romanian army in
        // Budapest, Kun fled). An ally fighting on, or a colony not taken, keeps the war going.
        overrun: 900,
        capital_overrun: 500,
        // The form a war revolution brings in. A form not listed (the republics) keeps itself
        // and only the cabinet falls: the new government asks for peace all the same, without
        // a change of regime.
        revolution: [
            ("absolute_monarchy", "parliamentary_republic"),
            ("constitutional_monarchy", "parliamentary_republic"),
            ("one_party_state", "military_dictatorship"),
        ],
        // A3, recommended: the countdown runs for the player too. "The player is never forced"
        // is `false`.
        player_forced: true,
    ),
    occupation: (
        // O1: occupied France paid occupation costs of 400 million francs a day from August
        // 1940, 300 million from May 1941 and 500 million from November 1942, besides the
        // requisitions and the STO's 650,000 workers; all told about a third of the French
        // national income in 1943 (Milward, 1970, *The New Order and the French Economy*;
        // Occhino, Oosterlinck and White, 2008, *Journal of Economic History* 68(1)).
        extraction_start: 200,
        extraction_cap: 330,
        extraction_weeks: 156,
        // O3: some 20 security men per thousand people for a hostile population, 2 to 4 for a
        // calm one (Quinlivan, 1995, *Parameters* 25(4)); Germany held some 2.5 per thousand
        // in France in 1941.
        garrison_calm: 2,
        garrison_hostile: 20,
        garrison_cap: 500,
        // Item 16: the occupier's own garrison formations (colonial ones apart) stand first; only
        // what they miss comes out of its field army, up to `garrison_cap`. An occupier without a
        // player that has held a region for `garrison_order_weeks` with its garrison short orders
        // garrison formations to cover the shortfall (one element for each element's men
        // missing), paid by the military ceiling. DESIGN VALUES: the 4 weeks and the one for one.
        garrison_unit: Some("garrison"),
        garrison_order_weeks: 4,
        resistance_start: 50,
        resistance_per_extraction: 20,
        resistance_per_shortfall: 40,
        resistance_calm: 5,
        // O2: the Soviet Union lost about a quarter of its reproducible capital, Poland more
        // than a third of its wealth (Harrison, 1998, *The Economics of World War II*).
        devastation_per_week: 4,
        devastation_full_losses: 5000,
        devastation_cap: 400,
        civilians_per_million: 20,
        // Scorched earth (`war::scorch`; switch `scorched_earth`, off). The owner chose the
        // recommended TE1 to TE5 (2026-11-28). The Soviet Union evacuated and
        // destroyed as it fell back in 1941, without a plan made beforehand (Harrison,
        // "Barbarossa: the Soviet Response, 1941", 1992, p. 7); the war destroyed about a
        // quarter of its pre-war capital (Harrison, "war economy", Encyclopedia of Russian
        // History, 2003, p. 2). No source gives the share a retreat destroyed:
        // - cap: most of a region's plant levels burned, per mille. DESIGN VALUE.
        // - full_weeks: weeks of fighting over the region for the whole cap. DESIGN VALUE.
        // - first: groups burned first (TE2 a), in order; the rest after.
        scorched: Some((
            cap: 500,
            full_weeks: 4,
            first: ["military_industry", "heavy_industry", "energy", "extraction",
                "light_industry", "infrastructure"],
        )),
    ),
    // The movement against the war (`war::antiwar`; switch `anti_war`, off). The owner's AW1
    // to AW5 are pending; the recommended ones are in place. DESIGN VALUES, without a source:
    // - strike: of the workers who back the movement, those on strike at a time, per mille;
    // - mutiny: of the soldiers who back it, those who refuse to fight, per mille;
    // - collapse_mobilized: mobilization (per mille of the people) from which the countdown to
    //   the fall runs below the peace threshold (the 4 % at which a movement moves a law);
    // - memory: per mille of the movement left at the start of a war taken off the starting
    //   support.
    anti_war: Some((
        movement: "anti_war",
        strike: 300,
        mutiny: 200,
        collapse_mobilized: 40,
        memory: 300,
        strikers: ["laborer", "skilled_worker"],
        soldiers: ["soldier"],
    )),
    // The colonial war (G6; docs/war.pt-BR.md, "Guerra colonial"). GC1 to GC5 are the owner's
    // questions, with the recommendation in place until answered.
    colonial: Some((
        // At the revolt the metropole keeps the states its garrison holds at the calm minimum
        // of O3 (Quinlivan, 1995): 2 men per thousand people, ports first.
        garrison: 2,
        // Algeria: some 80,000 French troops in November 1954, about 400,000 by 1956–57, landed
        // by Algiers, Oran and Bône (Horne, 1977, *A Savage War of Peace*; Alexander, Evans and
        // Keiger, 2002, *The Algerian War and the French Army*): some 320,000 men in two years,
        // about 3,000 a week, about 1,000 a port.
        men_per_port_week: 1000,
        // The landed men's cap, per mille of the metropole's land men. France's 400,000 in
        // Algeria were about half of its army, after the call-up of the reservists and the
        // service raised to 27 months (1956).
        expedition_cap: 500,
        // Combatants per mille of the men of service age, at full support. Design value,
        // checked in absolute numbers: Algeria, ALN 15,000 to 40,000 (NWC, DTIC ADA422710);
        // Malaya, MNLA 5,000 to 10,000, 7,000 to 8,000 at the peak (IWM; Stubbs, 1989).
        armed_share: 20,
        // Of those, under arms at the proclamation; the gap closes a share a week (some two
        // years to most of it), held back by the arms.
        initial_share: 100,
        recruit_week: 25,
        // GC2: the proclaimed country starts as a country attacked does.
        proclaimed: 800,
        // GC1: the colonial formations in the unit go over by the mobilization.
        defect: true,
        // GC3: half the irregulars' arms at the proclamation.
        equipment_at_birth: 500,
        // GC5: after a reconquest the movement starts again at half the mark of the revolt.
        movement_after_reconquest: 500,
        // The guerrilla in the states the metropole holds. Casualties of the metropole a week
        // per armed irregular there: Algeria some 10 per mille (about 25,000 French soldiers
        // killed in 7.5 years, four casualties to a death, against some 25,000 armed), Malaya
        // some 2 (1,865 of the security forces killed in 12 years against 7,000 to 8,000);
        // design value between them.
        ambush: 5,
        // The exchange, irregulars' casualties for each of the metropole's: Malaya about 3.6
        // (6,710 MNLA killed against 1,865) at a cover near 1, Algeria about 5.5 (some 141,000
        // ALN killed, French figures, against some 25,000) at a cover near 2.2 (400,000 men for
        // 180,000 needed); the line through the two: 2 + 1.6 x cover. Cover: the metropole's men
        // in the unit over 20 per thousand of the people it holds there (O3, hostile).
        exchange_base: 2000,
        exchange_per_cover: 1600,
        hostile: 20,
        // The AI lands until its men in the unit reach this cover, per mille of the O3 need (20
        // per thousand of the people it holds there), never past the cap; 0 lands up to the cap.
        // The player decides how many to send (`SetExpedition`).
        cover_target: 1000,
    )),
)
