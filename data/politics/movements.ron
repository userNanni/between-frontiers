// Movement kinds. Contract in crates/bf-sim/src/politics.rs, rules in docs/politics.pt-BR.md.
// Names in assets/i18n/*/politics.ftl (movement-<key>, movement-<key>-desc). Licence: CC BY-SA 4.0.
//
// A movement wants one law (or independence) and grows only while its whole `cause` holds:
// conditions on indicators of the simulation (politics::INDICATORS) or on the effects of the
// laws in force (politics::EFFECTS), measured among the people it draws from. Nothing is drawn by
// lot. The weakest condition sets the pace (MovementKind::pressure): `growth` per mille of those
// people join per year at the widest margin. When the cause stops holding, support halves every
// `persistence` years: a movement outlives its cause, and comes back stronger if the cause does.
//
// `among`: Everyone (the metropole, by profession), Colonies (colonial regions, and every region
// of a subject country, measured on the overlord's colonial laws) or Targeted (the communities a
// law in force targets). `professions`: who can join, per mille; empty means everyone.
(
    movements: [
        (
            key: "agrarian_reform",
            goal: Law("land_reform"),
            professions: [("peasant", 1000), ("farm_laborer", 1000)],
            cause: [
                ("landowner_rent", AtLeast(1100)),
                ("landowner_income_share", AtLeast(350)),
                ("needs_met", AtMost(650)),
            ],
            growth: 60,
            persistence: 30,
        ),
        (
            key: "labour_rights",
            goal: Law("collective_bargaining"),
            professions: [("laborer", 1000), ("skilled_worker", 1000), ("farm_laborer", 300)],
            cause: [
                ("union_bargaining", AtMost(300)),
                ("urbanization", AtLeast(150)),
                ("needs_met", AtMost(800)),
            ],
            growth: 80,
            persistence: 25,
        ),
        (
            key: "social_protection",
            goal: Law("social_security"),
            professions: [("laborer", 1000), ("skilled_worker", 1000), ("clerk", 500)],
            cause: [
                ("unemployment", AtLeast(80)),
                ("unemployment_benefit", AtMost(150)),
                ("urbanization", AtLeast(300)),
            ],
            growth: 60,
            persistence: 20,
        ),
        (
            key: "suffrage",
            goal: Law("universal_suffrage"),
            professions: [
                ("clerk", 1000), ("professional", 1000), ("engineer", 1000),
                ("skilled_worker", 700), ("laborer", 500), ("peasant", 200),
            ],
            cause: [("franchise", AtMost(500)), ("literacy", AtLeast(500))],
            growth: 70,
            persistence: 40,
        ),
        (
            key: "press_freedom",
            goal: Law("free_press"),
            professions: [("professional", 1000), ("engineer", 1000), ("clerk", 800)],
            cause: [("censorship", AtLeast(300)), ("literacy", AtLeast(400))],
            growth: 50,
            persistence: 20,
        ),
        (
            key: "independence",
            goal: Independence,
            among: Colonies,
            cause: [
                // An educated few, shut out of office and discriminated against.
                ("literacy", AtLeast(100)),
                ("colonial_self_rule", AtMost(400)),
                ("discrimination", AtLeast(150)),
            ],
            growth: 40,
            persistence: 60,
        ),
        (
            key: "colonial_labour_reform",
            goal: Law("free_labour"),
            among: Colonies,
            cause: [("unfree_labour", AtLeast(150)), ("literacy", AtLeast(50))],
            growth: 40,
            persistence: 30,
        ),
        (
            key: "civil_rights",
            goal: Law("equal_citizenship"),
            among: Targeted,
            cause: [("discrimination", AtLeast(300)), ("literacy", AtLeast(300))],
            growth: 60,
            persistence: 40,
        ),
        (
            key: "freedom_of_movement",
            goal: Law("free_movement"),
            professions: [("peasant", 1000), ("farm_laborer", 1000), ("laborer", 1000)],
            cause: [("migration_within_state", AtMost(500)), ("rural_wage_gap", AtLeast(1500))],
            growth: 40,
            persistence: 15,
        ),
        (
            key: "public_health",
            goal: Law("national_health_service"),
            professions: [
                ("laborer", 1000), ("skilled_worker", 1000), ("clerk", 1000), ("professional", 500),
            ],
            cause: [
                ("hospital_coverage", AtMost(400)),
                ("health_state_share", AtMost(500)),
                ("urbanization", AtLeast(350)),
            ],
            growth: 50,
            persistence: 20,
        ),
        (
            key: "public_schooling",
            goal: Law("compulsory_primary"),
            professions: [
                ("clerk", 1000), ("professional", 1000), ("skilled_worker", 1000), ("laborer", 500),
            ],
            cause: [
                ("school_coverage", AtMost(500)),
                ("school_enrolment_target", AtMost(500)),
                ("urbanization", AtLeast(200)),
            ],
            growth: 50,
            persistence: 20,
        ),
        (
            key: "nationalization",
            goal: Law("mixed_economy"),
            professions: [("laborer", 1000), ("skilled_worker", 1000), ("civil_servant", 700)],
            cause: [("unemployment", AtLeast(150)), ("state_ownership", AtMost(100))],
            growth: 70,
            persistence: 15,
        ),
        (
            key: "market_reform",
            goal: Law("regulated_market"),
            professions: [
                ("capitalist", 1000), ("manager", 1000), ("professional", 500), ("engineer", 500),
            ],
            cause: [("state_ownership", AtLeast(400)), ("needs_met", AtMost(700))],
            growth: 50,
            persistence: 15,
        ),
        (
            key: "tax_revolt",
            goal: Law("proportional_income_tax"),
            professions: [
                ("capitalist", 1000), ("landowner", 1000), ("manager", 1000), ("professional", 500),
            ],
            cause: [("tax_burden", AtLeast(250)), ("tax_cap_upper", AtLeast(400))],
            growth: 80,
            persistence: 8,
        ),
        // Income tax: where duties and excises fall on everyone and the rich pay little, the
        // townspeople who can read ask for a tax on incomes. Reform goes by steps, so it reaches
        // proportional tax first.
        (
            key: "income_tax",
            goal: Law("progressive_income_tax"),
            professions: [
                ("laborer", 700), ("skilled_worker", 1000), ("clerk", 1000), ("professional", 700),
                ("civil_servant", 1000),
            ],
            cause: [
                ("tax_cap_upper", AtMost(250)),
                ("urbanization", AtLeast(250)),
                ("literacy", AtLeast(400)),
            ],
            growth: 60,
            persistence: 20,
        ),
        // Fiscal reform: a treasury that cannot pay its servants and soldiers, under duties and
        // excises that cannot rise, turns the state's own people and the townspeople to a tax on
        // incomes. By steps: proportional first.
        (
            key: "fiscal_reform",
            goal: Law("progressive_income_tax"),
            professions: [
                ("civil_servant", 1000), ("soldier", 1000), ("clerk", 1000), ("skilled_worker", 500),
                ("laborer", 300), ("peasant", 150),
            ],
            cause: [("fiscal_stress", AtLeast(100)), ("tax_cap_upper", AtMost(250))],
            growth: 120,
            persistence: 10,
        ),
        // Immigration reform: an economy that grows with no hands to spare, behind quotas or a
        // closed door, turns employers and landowners to opening it (the United States in 1965).
        (
            key: "immigration_reform",
            goal: Law("open_immigration"),
            professions: [
                ("capitalist", 1000), ("manager", 1000), ("landowner", 600), ("professional", 300),
                ("engineer", 300),
            ],
            cause: [
                ("immigration", AtMost(500)),
                ("unemployment", AtMost(40)),
                ("gdp_growth", AtLeast(30)),
            ],
            growth: 50,
            persistence: 15,
        ),
        (
            key: "protectionism",
            goal: Law("protective_tariffs"),
            professions: [
                ("laborer", 700), ("skilled_worker", 700), ("capitalist", 500), ("peasant", 300),
            ],
            cause: [
                ("import_share", AtLeast(300)),
                ("unemployment", AtLeast(100)),
                ("tariff", AtMost(150)),
            ],
            growth: 60,
            persistence: 10,
        ),
        (
            key: "anti_corruption",
            goal: Law("merit_service"),
            professions: [
                ("professional", 1000), ("engineer", 1000), ("clerk", 700), ("manager", 500),
            ],
            cause: [("corruption", AtLeast(100)), ("literacy", AtLeast(500))],
            growth: 50,
            persistence: 20,
        ),
        (
            key: "secularism",
            goal: Law("separation"),
            professions: [
                ("professional", 1000), ("engineer", 1000), ("clerk", 500), ("skilled_worker", 300),
            ],
            cause: [
                ("church_privilege", AtLeast(400)),
                ("urbanization", AtLeast(400)),
                ("literacy", AtLeast(700)),
            ],
            growth: 30,
            persistence: 30,
        ),
        (
            key: "clerical_reaction",
            goal: Law("state_church"),
            professions: [("clergy", 1000), ("landowner", 500), ("peasant", 400)],
            cause: [("church_privilege", AtMost(-200))],
            growth: 80,
            persistence: 30,
        ),
        (
            key: "nativism",
            goal: Law("quota_immigration"),
            professions: [
                ("laborer", 600), ("skilled_worker", 600), ("peasant", 300), ("clerk", 300),
            ],
            cause: [
                ("immigrant_share", AtLeast(100)),
                ("unemployment", AtLeast(80)),
                ("immigration", AtLeast(600)),
            ],
            growth: 60,
            persistence: 15,
        ),
        // Regime change: a government that does not answer the movements loses legitimacy, and
        // with mass unemployment the middle classes, soldiers and part of the workers turn to a
        // single party. Which party (nationalist or revolutionary) is not modelled: the regime
        // is the same law, and the groups in power decide what follows.
        (
            key: "regime_change",
            goal: Law("one_party_state"),
            professions: [
                ("clerk", 600), ("skilled_worker", 400), ("laborer", 400), ("peasant", 300),
                ("soldier", 800), ("landowner", 300), ("capitalist", 200), ("professional", 300),
            ],
            cause: [("legitimacy", AtMost(500)), ("unemployment", AtLeast(150))],
            growth: 100,
            persistence: 15,
        ),
        // Against the war (`war::antiwar`; switch `anti_war`, off: the movement leaves the
        // catalogue). Those who make the war's weapons and those who fight it: the munitions
        // strike of January 1918 began in Berlin's munitions and metal plants, some 400,000
        // workers (GHDI, "The Strikes of January 1918", p. 1); the French mutinies of 1917
        // touched 49 of 113 infantry divisions (Pedroncini, 1967, NO PAGE). Its cause is the
        // weariness of its recruits, 1000 less their groups' war support, at war only; it moves
        // every week of war. growth and persistence: DESIGN VALUES.
        (
            key: "anti_war",
            goal: Peace,
            professions: [
                ("laborer", 1000), ("skilled_worker", 1000), ("peasant", 600),
                ("farm_laborer", 600), ("soldier", 800), ("clerk", 300), ("professional", 300),
            ],
            cause: [("war_weariness", AtLeast(600))],
            growth: 300,
            persistence: 5,
        ),
        // Revisionism: win back the land and the standing lost (in 1925, Versailles, Trianon,
        // Neuilly). Measured, never won, until borders and war exist (phases 4 and 5).
        (
            key: "revisionism",
            goal: Revision,
            professions: [
                ("clerk", 500), ("professional", 400), ("soldier", 1000), ("landowner", 600),
                ("skilled_worker", 300), ("peasant", 200),
            ],
            cause: [("lost_territory", AtLeast(50)), ("unemployment", AtLeast(80))],
            growth: 60,
            persistence: 40,
        ),
    ],
)
